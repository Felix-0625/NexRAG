# Local Python settings. Replace these three files for your own business source.
BUSINESS_SOURCE_PATH=examples/olist/business-source.yaml
METADATA_PATH=examples/olist/metadata.yaml
TENANT_ACCESS_PATH=examples/olist/tenant-access.yaml

# Optional absolute path to override database_path in the source profile.
# BUSINESS_DB_PATH=
# PostgreSQL profiles read credentials only from this environment variable.
BUSINESS_DB_DSN=

# Set each key to an independent random value with at least 32 characters.
# The same NexRAG key is passed to Open WebUI and its Agent backend.
NEXRAG_SHARED_API_KEY=
NEXRAG_USER_JWT_SECRET=
WEBUI_SECRET_KEY=
INGESTION_API_KEY=
RETRIEVAL_API_KEY=

# Comma-separated browser origins allowed to call NexRAG directly with
# credentials. Open WebUI's backend calls NexRAG server-to-server and is not
# affected by this. Only needed if a browser hits NexRAG's API directly.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# After creating the first Open WebUI admin, set this to false to disable
# self-registration for subsequent users.
ENABLE_SIGNUP=true

# The local default requires: ollama pull qwen3:4b-instruct
LLM_API_BASE=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL_NAME=qwen3:4b-instruct
# Context for the Ollama process started by start.cmd (multi-tool turns need more than 4096).
OLLAMA_CONTEXT_LENGTH=16384

# Both AarhusAI services use the same local 1024-dimensional bge-m3 model.
# Change model and dimension together before indexing any documents.
EMBEDDING_API_BASE_URL=http://127.0.0.1:11434/v1
EMBEDDING_API_KEY=ollama
EMBEDDING_MODEL=bge-m3
TOKENIZER_MODEL=BAAI/bge-m3
CHUNK_SPLIT_BY=token

# Ingestion and retrieval share one physical Qdrant collection. Existing BM42
# vectors require a separate, fully rebuilt index before switching to BGE-M3.
QDRANT_INDEX=nexrag_knowledge_bge_m3
ENABLE_SPARSE_EMBEDDINGS=true
ENABLE_HYBRID_SEARCH=true
ENABLE_FIVE_CHANNEL_RETRIEVAL=true
ENABLE_BODY_LEXICAL_RETRIEVAL=false
# Opt in for workloads that need entity relationships and graph paths.
ENABLE_GRAPH_RAG=false
# Native Dense/Sparse candidate fusion, separate from RERANK_FUSION below.
HYBRID_FUSION=rrf
HYBRID_RRF_K=2
HYBRID_DENSE_WEIGHT=1
HYBRID_SPARSE_WEIGHT=1
# Optional candidate: index upload titles in sparse vectors and use them in reranking.
# Reingest into a separate collection when comparing this setting.
ENABLE_FILENAME_RETRIEVAL=false
# Experimental explicit-source title prior; default off pending independent validation.
ENABLE_TITLE_ROUTING=false
# Resolve an explicit source reference before searching its evidence passages.
ENABLE_DOCUMENT_SCOPED_RETRIEVAL=false
# Reserve a bounded part of the existing pool for unseen sections of a resolved document.
ENABLE_DOCUMENT_CANDIDATE_RESERVE=false
# Experimental Chinese Parent BM25 route using an authorized Qdrant snapshot.
ENABLE_ZH_LEXICAL_RETRIEVAL=false
SPARSE_MODEL=BAAI/bge-m3
EMBEDDING_THREADS=2
ENABLE_PARENT_CHILD_CHUNKS=true
PARENT_CHUNK_SIZE=1200
PARENT_CHUNK_OVERLAP=0
# Optional indexed neighborhoods. Enable before normal ingestion/reingestion.
ENABLE_CONTEXT_WINDOWS=false
CONTEXT_WINDOW_SIZE=1
INITIAL_RETRIEVAL_MULTIPLIER=3
# High-recall profile: 150 adds ~0.02 legal Recall@10 for ~2.4 s more P95.
# RETRIEVAL_CANDIDATE_LIMIT=150
PARENT_CANDIDATE_MULTIPLIER=3
ENABLE_RERANKING=true
RERANKER_PROVIDER=fastembed
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_THREADS=2
RERANK_FUSION=replace
RERANK_RRF_K=60
RERANK_TOP_K=3
RERANK_DEDUP_BEFORE_LIMIT=false
RETRIEVAL_CONTEXT_MODE=parent
# Legal K=10 receipt: .local-run/quality-20261109/tune-legal-01/ (V6).
RERANK_MIN_SCORE=0
RERANK_REQUIRED=true

# Local Python client settings. The launcher wires dynamically selected ports.
RETRIEVAL_API_BASE_URL=http://localhost:8002
RETRIEVAL_TIMEOUT_SECONDS=45
# Optional request K (1–20). Leave unset to use the active RSI parameter (initially 3).
# KNOWLEDGE_TOP_K=16
# Require a retrieval attempt on knowledge-only deployments for otherwise unbound chat.
REQUIRE_KNOWLEDGE_EVIDENCE=false
KNOWLEDGE_COLLECTION_NAME=nexrag_docs

# Admin uploads to the Agent's shared knowledge base (GET/POST/DELETE /v1/ops/knowledge).
INGESTION_API_BASE_URL=http://localhost:8001
INGESTION_TIMEOUT_SECONDS=120

# Folder bound on the host; Agent export_analysis files land here, organised
# by user and chat. NexRAG and the web backend share this native filesystem path.
ARTIFACTS_DIR=./data/artifacts

# Optional SearXNG JSON service; core local RAG does not require it.
# Leave the URL empty until a separate service is available. Port 8080 is WebUI.
ENABLE_WEB_SEARCH=true
SEARXNG_URL=
WEB_SEARCH_TIMEOUT_SECONDS=8.0

# Operations data domain: traces, scores, datasets, artifact versions,
# proposals, and memory metadata (writable; separate from business data).
OPS_DB_PATH=data/ops/ops.db
# redacted (default) masks PII; none keeps only structure and scores; full is for local debugging.
TRACE_STORE_CONTENT=redacted
TRACE_RETENTION_DAYS=30

# Long-term memory (per signed-in user; vectors in their own Qdrant collection).
ENABLE_MEMORY=true
QDRANT_URI=http://localhost:6333
MEMORY_COLLECTION=nexrag_memory
MEMORY_RETENTION_DAYS=365

# Self-evolution. Proposals always need an administrator; see docs/evaluation-and-rsi.md.
EVOLUTION_MIN_CLUSTER_SIZE=5
EVOLUTION_MIN_GAIN=0.02
PROPOSAL_TTL_DAYS=14
PROPOSAL_QUEUE_LIMIT=10
CANARY_RATIO=0.10
CANARY_MIN_DAYS=3
