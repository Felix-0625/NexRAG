@@ -0,0 +1,104 @@
+<script lang="ts">
+	export let directory: any;
+	export let rows: any[];
+	export let onEdit: (account: any) => void;
+	export let onAccount: (account: any) => void;
+	export let onSecurity: (account: any) => void;
+	function effectiveGrants(account: any): string[] {
+		return account.role === 'admin'
+			? Object.keys(directory.tenants)
+			: (directory.grants[account.email] ?? []);
+	}
+	function grantDifference(account: any, profile: any) {
+		const manager = directory.users.find((item: any) => item.id === profile?.manager_id);
+		if (!manager) return '无上级对照';
+		const mine = effectiveGrants(account);
+		const parent = effectiveGrants(manager);
+		const extra = mine.filter((id) => !parent.includes(id));
+		const fewer = parent.filter((id) => !mine.includes(id));
+		if (!extra.length && !fewer.length) return '与上级范围相同';
+		return [
+			extra.length ? `额外：${extra.map((id) => directory.tenants[id] ?? id).join('、')}` : '',
+			fewer.length ? `未授予：${fewer.map((id) => directory.tenants[id] ?? id).join('、')}` : ''
+		]
+			.filter(Boolean)
+			.join('；');
+	}
+</script>
+
+<div class="overflow-x-auto rounded-xl border border-gray-200 dark:border-gray-750">
+	<table class="employee-directory w-full text-left text-sm">
+		<thead class="bg-gray-50 text-gray-500 dark:bg-gray-900"
+			><tr
+				><th class="p-3 font-normal">员工 / 登录账号</th><th class="p-3 font-normal">部门 · 职级</th
+				><th class="p-3 font-normal">直属上级</th><th class="p-3 font-normal">业务范围</th><th
+					class="p-3 font-normal">权限差异</th
+				><th class="p-3 font-normal">管理</th></tr
+			></thead
+		>
+		<tbody
+			>{#each rows as account}
+				{@const profile = directory.accounts.find((item: any) => item.user_id === account.id)}
+				<tr class="border-t border-gray-100 dark:border-gray-800">
+					<td class="p-3" data-label="员工 / 登录账号"
+						><p>{account.name}</p>
+						<p class="mt-1 text-xs text-gray-500">{account.email} · {account.role}</p></td
+					>
+					<td class="p-3" data-label="部门 · 职级"
+						>{directory.departments.find((item: any) => item.id === profile?.department_id)?.name ??
+							'待编入部门'}
+						<p class="text-xs text-gray-500">{profile?.job_level ?? '未设置职级'}</p></td
+					>
+					<td class="p-3" data-label="直属上级"
+						>{directory.users.find((item: any) => item.id === profile?.manager_id)?.name ??
+							'无'}</td
+					>
+					<td class="p-3" data-label="业务范围"
+						>{effectiveGrants(account)
+							.map((id: string) => directory.tenants[id] ?? id)
+							.join('、') || '未授予业务权限'}</td
+					>
+					<td class="p-3" data-label="权限差异">{grantDifference(account, profile)}</td><td
+						class="p-3"
+						data-label="管理"
+						><div class="flex flex-wrap gap-3">
+							<button class="text-blue-600" on:click={() => onEdit(account)}>组织与授权</button
+							><button class="text-gray-500" on:click={() => onAccount(account)}>密码 / 状态</button
+							><button class="text-gray-500" on:click={() => onSecurity(account)}>安全记录</button>
+						</div></td
+					>
+				</tr>
+			{/each}</tbody
+		>
+	</table>
+</div>
+
+<style>
+	/* Keep the same controls and reading order in narrow desktop side panels. */
+	@media (max-width: 767px) {
+		.employee-directory,
+		.employee-directory tbody,
+		.employee-directory tr,
+		.employee-directory td {
+			display: block;
+			width: 100%;
+		}
+		.employee-directory thead {
+			display: none;
+		}
+		.employee-directory tr {
+			padding: 0.5rem 0;
+		}
+		.employee-directory td {
+			padding: 0.4rem 1rem;
+			overflow-wrap: anywhere;
+		}
+		.employee-directory td::before {
+			content: attr(data-label);
+			display: block;
+			margin-bottom: 0.25rem;
+			font-size: 0.75rem;
+			color: #9ca3af;
+		}
+	}
+</style>
