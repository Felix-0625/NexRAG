@@ -0,0 +1,93 @@
+"""Provision employees with reviewed grants using the existing auth system."""
+import secrets
+
+from fastapi import APIRouter, Depends, HTTPException, Request
+from open_webui.internal.db import get_async_session
+from open_webui.models.access_grants import AccessGrants
+from open_webui.models.auths import AddUserForm
+from open_webui.models.users import Users
+from open_webui.routers.auths import add_user
+from open_webui.utils.auth import get_admin_user
+from open_webui.utils.nexrag_core import core_request
+from open_webui.utils.nexrag_privacy import require_knowledge
+from open_webui.utils.nexrag_workspace import readable_knowledge
+from pydantic import BaseModel, Field
+from sqlalchemy.ext.asyncio import AsyncSession
+
+router = APIRouter()
+
+
+class EmployeeForm(BaseModel):
+    email: str = Field(min_length=3, max_length=254)
+    name: str = Field(min_length=1, max_length=100)
+    user_id: str = Field(default='', max_length=128)
+    department_id: str = Field(default='', max_length=100)
+    job_level: str = Field(default='', max_length=40)
+    manager_id: str = Field(default='', max_length=128)
+    tenant_ids: list[str] = Field(default_factory=list, max_length=100)
+    knowledge_ids: list[str] = Field(default_factory=list, max_length=100)
+    egress: dict = Field(default_factory=dict)
+
+
+@router.get('/directory')
+async def directory_view(request: Request, user=Depends(get_admin_user)):
+    users = await Users.get_users()
+    rows = users['users'] if isinstance(users, dict) else users
+    payload = await core_request(request, user, 'workspace/directory')
+    registered = {item['user_id'] for item in payload['accounts']}
+    for item in rows:
+        if item.id not in registered:
+            await core_request(request, user, 'workspace/directory/identities', 'POST',
+                               {'user_id': item.id, 'email': item.email, 'name': item.name})
+    if any(item.id not in registered for item in rows):
+        payload = await core_request(request, user, 'workspace/directory')
+    payload['catalog'] = await core_request(request, user, 'workspace/policy/tools')
+    payload['users'] = [{'id': item.id, 'name': item.name, 'email': item.email, 'role': item.role,
+                         'created_at': item.created_at, 'profile_image_url': item.profile_image_url}
+                        for item in rows]
+    owned = [item for item in await readable_knowledge(user) if item.user_id == user.id]
+    payload['knowledge'] = [{'id': item.id, 'name': item.name} for item in owned]
+    resource_grants = {item.id: await AccessGrants.get_grants_by_resource('knowledge', item.id) for item in owned}
+    for account in payload['accounts']:
+        account['knowledge_ids'] = [identifier for identifier, grants in resource_grants.items() if any(
+            grant.principal_type == 'user' and grant.principal_id == account['user_id'] and grant.permission == 'read'
+            for grant in grants)]
+    return payload
+
+
+@router.post('/directory/accounts')
+async def provision_employee(body: EmployeeForm, request: Request, user=Depends(get_admin_user),
+                             db: AsyncSession = Depends(get_async_session)):
+    grants = body.model_dump(exclude={'knowledge_ids'})
+    grants['user_id'] = body.user_id or 'new-account-preflight'
+    for identifier in body.knowledge_ids:
+        knowledge = await require_knowledge(identifier, user, write=True)
+        if knowledge.user_id != user.id:
+            raise HTTPException(403, '只能分发自己维护的企业知识库')
+    await core_request(request, user, 'workspace/directory/validate', 'POST', grants)
+    temporary_password = None
+    if body.user_id:
+        employee = await Users.get_user_by_id(body.user_id)
+        if not employee or employee.email != body.email.lower():
+            raise HTTPException(400, '账号身份已变更，请刷新后重新选择')
+    else:
+        temporary_password = secrets.token_urlsafe(24)
+        # Leave the new account pending until both identity and core grants
+        # have been persisted. A bridge failure never creates an active account.
+        created = await add_user(request, AddUserForm(email=body.email, name=body.name,
+                                 password=temporary_password, role='pending'), user, db)
+        employee = await Users.get_user_by_id(created['id'])
+        grants['user_id'] = employee.id
+    await core_request(request, user, 'workspace/directory/accounts', 'POST', grants)
+    await Users.update_user_by_id(employee.id, {'name': body.name}, db=db)
+    for knowledge in await readable_knowledge(user):
+        if knowledge.user_id != user.id:
+            continue
+        if knowledge.id in body.knowledge_ids:
+            await AccessGrants.grant_access('knowledge', knowledge.id, 'user', employee.id, 'read')
+        else:
+            await AccessGrants.revoke_access('knowledge', knowledge.id, 'user', employee.id, 'read')
+    if not body.user_id:
+        await Users.update_user_role_by_id(employee.id, 'user', db=db)
+    return {'id': employee.id, 'temporary_password': temporary_password, 'must_change_password': bool(temporary_password),
+            'message': '账号已分发；初次登录必须更改临时密码' if temporary_password else '组织与授权已保存'}
diff --git a/backend/open_webui/routers/nexrag_governance.py b/backend/open_webui/routers/nexrag_governance.py
