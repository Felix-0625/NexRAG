+	{#if error}<p role="alert" class="rounded-lg border border-red-200 p-3 text-sm text-red-600 dark:border-red-900">{error}</p>{/if}
+	{#if testResult}<p role="status" class="text-sm text-green-600">{testResult}</p>{/if}
+	{#if showForm && $user?.role === 'admin'}
+		<form class="rounded-xl border border-gray-200 dark:border-gray-800 p-4 space-y-4" on:submit|preventDefault={save}>
+			<div class="flex justify-between"><h2 class="font-medium">{editing ? '编辑模型' : '添加模型'}</h2><button type="button" class="text-sm text-gray-500" on:click={() => {showForm = false; form.api_key = '';}}>取消</button></div>
