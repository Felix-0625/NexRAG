@@ -0,0 +1,90 @@
+<script lang="ts">
+	import { onMount } from 'svelte';
+	import { workspaceRequest } from '$lib/apis/nexrag';
+	export let knowledgeId: string;
+	let policy: any = null;
+	let error = '';
+	let message = '';
+	async function save() {
+		error = '';
+		message = '';
+		if (policy.classification === 'secret') {
+			policy.external_models = false;
+			policy.external_search = false;
+			policy.external_tools = false;
+		}
+		if (policy.classification !== 'public') {
+			policy.enterprise_all = false;
+			policy.external_search = false;
+		}
+		try {
+			await workspaceRequest(`knowledge/${knowledgeId}/policy`, 'POST', policy);
+			message = '分级和分发范围已更新';
+		} catch (cause) {
+			error = String(cause);
+		}
+	}
+	onMount(async () => {
+		try {
+			policy = await workspaceRequest(`knowledge/${knowledgeId}/policy`);
+		} catch (cause) {
+			error = String(cause);
+		}
+	});
+</script>
+
+{#if policy}
+	<section class="mx-3 my-3 rounded-xl border border-gray-200 p-4 text-sm dark:border-gray-750">
+		<h2 class="font-medium">知识类型与数据保护</h2>
+		<p class="mt-2 text-xs text-gray-500">
+			私人知识默认只在本机处理。公开企业知识可自动下发全员；内部或机密资料请通过访问授权选择账号或分组。
+		</p>
+		<form class="mt-4 space-y-3" on:submit|preventDefault={save}>
+			<label class="flex flex-wrap items-center gap-3"
+				>内容分级
+				<select
+					class="rounded-lg border border-gray-300 bg-transparent px-3 py-2 dark:border-gray-700"
+					bind:value={policy.classification}
+					disabled={!policy.can_manage}
+				>
+					<option value="public">公开</option><option value="internal">内部</option><option
+						value="secret">核心机密 · 仅本机</option
+					>
+				</select>
+			</label>
+			{#if policy.is_admin}<label class="flex items-center gap-2"
+					><input
+						type="checkbox"
+						bind:checked={policy.enterprise_all}
+						disabled={!policy.can_manage || policy.classification !== 'public'}
+					/>企业公共知识 · 自动下发所有账号</label
+				>{/if}
+			<label class="flex items-center gap-2"
+				><input
+					type="checkbox"
+					bind:checked={policy.external_models}
+					disabled={!policy.can_manage || policy.classification === 'secret'}
+				/>允许已获授权的外部模型处理此库</label
+			>
+			<label class="flex items-center gap-2"
+				><input
+					type="checkbox"
+					bind:checked={policy.external_search}
+					disabled={!policy.can_manage || policy.classification !== 'public'}
+				/>允许公开内容用于外部搜索</label
+			>
+			<label class="flex items-center gap-2"
+				><input
+					type="checkbox"
+					bind:checked={policy.external_tools}
+					disabled={!policy.can_manage || policy.classification === 'secret'}
+				/>允许已审批工具处理此库</label
+			>
+			{#if policy.can_manage}<button class="rounded-lg bg-blue-600 px-4 py-2 text-white"
+					>保存保护策略</button
+				>{:else}<p class="text-gray-500">内容分级由知识库所有者维护。</p>{/if}
+			{#if error}<p role="alert" class="text-red-600">{error}</p>{/if}
+			{#if message}<p role="status" class="text-green-600">{message}</p>{/if}
+		</form>
+	</section>
+{/if}
