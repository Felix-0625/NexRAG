+"""Local file-to-library document identity registry, without document bodies.
+
+This registry supports deletion of the independently indexed copies of a file.
+Parent text remains exclusively in Qdrant child payloads.
+"""
+
+import hashlib
+import sqlite3
+from contextlib import contextmanager
+from pathlib import Path
+
+from open_webui.env import DATA_DIR
+
+
+@contextmanager
+def registry():
+    conn = sqlite3.connect(Path(DATA_DIR) / 'nexrag-ingestion.db', timeout=30)
+    try:
+        conn.execute('CREATE TABLE IF NOT EXISTS documents (file_id TEXT, collection_name TEXT, scoped_id TEXT UNIQUE, PRIMARY KEY(file_id, collection_name))')
+        yield conn
+        conn.commit()
+    finally:
+        conn.close()
+
+
+def scoped_id(file_id, collection_name):
+    if collection_name == f'file-{file_id}':
+        return file_id
+    return hashlib.sha256(f'{file_id}:{collection_name}'.encode()).hexdigest()
+
+
+def remember(file_id, collection_name, identifier):
+    with registry() as conn:
+        conn.execute('INSERT OR REPLACE INTO documents VALUES (?,?,?)', (file_id, collection_name, identifier))
+
+
+def document_ids(file_id, collection_name=None):
+    with registry() as conn:
+        if collection_name:
+            return [scoped_id(file_id, collection_name)]
+        return list({file_id, *(row[0] for row in conn.execute('SELECT scoped_id FROM documents WHERE file_id=?', (file_id,)))})
diff --git a/backend/open_webui/utils/nexrag_integration_guard.py b/backend/open_webui/utils/nexrag_integration_guard.py
new file mode 100644
--- /dev/null
+++ b/backend/open_webui/utils/nexrag_integration_guard.py
@@ -0,0 +1,147 @@
+"""Keep upstream direct integrations outside the native enterprise boundary.
+
+Native requests must use NexRAG's policy-enforced agent endpoint. Merely hiding
+Open WebUI controls would leave provider, URL ingestion and MCP routes usable.
+This middleware rejects those alternative entry points before they can run.
+"""
+
+import json
+import os
+
+from starlette.responses import JSONResponse
+
+
+_BLOCKED_PREFIXES = (
+    '/openai', '/ollama', '/api/v1/pipelines', '/api/v1/terminals',
+    '/api/v1/configs/connections', '/api/v1/configs/tool_servers',
+    '/api/v1/configs/terminal_servers', '/api/v1/configs/code_execution',
+    '/api/v1/configs/subagents', '/api/v1/configs/import',
+    '/api/message', '/api/v1/messages', '/api/embeddings', '/api/v1/embeddings',
+    '/api/v1/retrieval/process/url', '/api/v1/retrieval/process/web',
+    '/api/v1/retrieval/process/youtube', '/api/v1/retrieval/embedding/update',
+    '/api/v1/retrieval/config/update',
+)
+_CHAT_PATHS = {'/api/chat/completions', '/api/v1/chat/completions', '/api/chat/completed'}
+_SETTINGS_PATH = '/api/v1/users/user/settings/update'
+_EXTERNAL_FEATURES = {'web_search', 'code_interpreter', 'image_generation',
+                      'terminal', 'subagents', 'direct_connections'}
+
+
+def _under(path, prefix):
+    return path == prefix or path.startswith(prefix + '/')
+
+
+def _remote_url(value):
+    return isinstance(value, str) and value.strip().lower().startswith(('http:', 'https:', '//'))
+
+
+def _remote_attachments(payload):
+    files = payload.get('files') or []
+    if isinstance(files, list) and any(isinstance(item, dict) and _remote_url(item.get('url')) for item in files):
+        return True
+    for message in payload.get('messages') or []:
+        if not isinstance(message, dict):
+            continue
+        if _remote_attachments({'files': message.get('files')}):
+            return True
+        content = message.get('content')
+        if isinstance(content, list):
+            for item in content:
+                if isinstance(item, dict) and item.get('type') in {'image_url', 'input_image'}:
+                    image = item.get('image_url') or item.get('url')
+                    if _remote_url(image.get('url') if isinstance(image, dict) else image):
+                        return True
+    return False
+
+
+def unsafe_chat_payload(payload):
+    """Inspect structured capabilities, never text inside the user's messages."""
+    if not isinstance(payload, dict):
+        return True
+    if _remote_attachments(payload):
+        return True
+    item = payload.get('model_item')
+    if payload.get('direct') or (isinstance(item, dict) and item.get('direct')):
+        return True
+    for name in ('tool_servers', 'direct_tool_servers', 'tools', 'functions', 'terminal_id'):
+        if payload.get(name):
+            return True
+    tool_ids = payload.get('tool_ids') or []
+    if not isinstance(tool_ids, list):
+        return True
+    if any(not isinstance(value, str) or value.startswith(('server:', 'mcp:', 'terminal:')) for value in tool_ids):
+        return True
+    # Explicit deployer opt-in applies only to admin-maintained Python plugins;
+    # it must never enable upstream remote MCP/direct server paths.
+    if tool_ids and os.environ.get('NEXRAG_ALLOW_TRUSTED_PLUGINS') != 'true':
+        return True
+    features = payload.get('features') or {}
+    if not isinstance(features, dict) or any(features.get(name) for name in _EXTERNAL_FEATURES):
+        return True
+    metadata = payload.get('metadata')
+    return bool(metadata and (not isinstance(metadata, dict) or unsafe_chat_payload(metadata)))
+
+
+class NativeIntegrationGuard:
+    """ASGI body replay avoids reliance on framework body-cache internals."""
+
+    def __init__(self, app, max_body_bytes=8 * 1024 * 1024):
+        self.app = app
+        self.max_body_bytes = max_body_bytes
+
+    async def __call__(self, scope, receive, send):
+        if scope['type'] != 'http' or os.environ.get('NEXRAG_WORKSPACE') != 'true':
+            return await self.app(scope, receive, send)
+        path = scope['path'].rstrip('/') or '/'
+        if any(_under(path, prefix) for prefix in _BLOCKED_PREFIXES):
+            return await self._reject(scope, receive, send)
+        is_chat = path in _CHAT_PATHS or _under(path, '/api/chat/actions')
+        is_settings = path == _SETTINGS_PATH
+        if scope['method'] not in {'POST', 'PUT', 'PATCH'} or not (is_chat or is_settings):
+            return await self.app(scope, receive, send)
+        chunks = []
+        size = 0
+        while True:
+            message = await receive()
+            if message['type'] == 'http.disconnect':
+                return
+            chunk = message.get('body', b'')
+            size += len(chunk)
+            if size > self.max_body_bytes:
+                return await self._reject(scope, receive, send, 413, '请求超过原生入口大小限制')
+            chunks.append(chunk)
+            if not message.get('more_body', False):
+                break
+        body = b''.join(chunks)
+        try:
+            payload = json.loads(body)
+        except (ValueError, UnicodeDecodeError):
+            return await self._reject(scope, receive, send, 400, '请求必须是 JSON 对象')
+        if not isinstance(payload, dict):
+            return await self._reject(scope, receive, send, 400, '请求必须是 JSON 对象')
+        if is_chat and unsafe_chat_payload(payload):
+            return await self._reject(scope, receive, send)
+        ui = payload.get('ui')
+        if is_settings and (payload.get('directConnections') or
+                            payload.get('notifications') or
+                            (isinstance(ui, dict) and (ui.get('toolServers') or
+                              (isinstance(ui.get('notifications'), dict) and ui['notifications'].get('webhook_url'))))):
+            return await self._reject(scope, receive, send)
+        replayed = False
+
+        async def replay():
+            nonlocal replayed
+            if not replayed:
+                replayed = True
+                return {'type': 'http.request', 'body': body, 'more_body': False}
+            return await receive()
+
+        await self.app(scope, replay, send)
+
+    @staticmethod
+    async def _reject(scope, receive, send, status=403, message=None):
+        response = JSONResponse(status_code=status, content={'detail': {
+            'code': 'native_integration_disabled',
+            'message': message or '原生模式禁止上游直连、远程 MCP 和外部执行入口；请使用 NexRAG 统一授权能力',
+        }})
+        await response(scope, receive, send)
diff --git a/backend/open_webui/utils/nexrag_knowledge_policy.py b/backend/open_webui/utils/nexrag_knowledge_policy.py
new file mode 100644
--- /dev/null
+++ b/backend/open_webui/utils/nexrag_knowledge_policy.py
@@ -0,0 +1,38 @@
+"""Owner-managed KB classification, using the existing metadata and ACL tables."""
+from open_webui.models.access_grants import AccessGrants
+from open_webui.models.knowledge import Knowledges
+
+DEFAULT_POLICY = dict(classification='internal', external_models=False, external_search=False, external_tools=False)
+
+
+def policy_for(knowledge):
+    configured = (knowledge.meta or {}).get('nexrag_policy', {})
+    return {key: configured.get(key, value) for key, value in DEFAULT_POLICY.items()}
+
+
+async def labels_for(user):
+    from open_webui.utils.nexrag_workspace import readable_knowledge
+    from open_webui.utils.nexrag_generations import collection_for
+    return {collection_for(item): policy_for(item) for item in await readable_knowledge(user)}
+
+
+async def update_policy(knowledge, user, policy, enterprise_all):
+    from fastapi import HTTPException
+    if knowledge.user_id != user.id:
+        raise HTTPException(403, '只有知识库所有者可以修改内容分级')
+    if enterprise_all and (user.role != 'admin' or policy['classification'] != 'public'):
+        raise HTTPException(400, '仅管理员维护的公开企业知识可以下发给全员；机密资料请按账号或分组授权')
+    if policy['classification'] == 'secret' and any(policy[key] for key in ('external_models', 'external_search', 'external_tools')):
+        raise HTTPException(400, '核心机密只能在本机处理，禁止联网搜索和外部工具')
+    if policy['classification'] != 'public' and policy['external_search']:
+        raise HTTPException(400, '内部资料不允许对外搜索')
+    metadata = {**(knowledge.meta or {}), 'nexrag_policy': policy, 'nexrag_enterprise_all': enterprise_all}
+    # Tightening removes wildcard access first. Loosening adds it last, after
+    # the owner explicitly approved a public classification.
+    if not enterprise_all:
+        for principal_type in ('user', 'anyone'):
+            await AccessGrants.revoke_access('knowledge', knowledge.id, principal_type, '*', 'read')
+    await Knowledges.update_knowledge_meta_by_id(knowledge.id, metadata)
+    if enterprise_all:
+        await AccessGrants.grant_access('knowledge', knowledge.id, 'user', '*', 'read')
+    return {**policy, 'enterprise_all': enterprise_all}
diff --git a/backend/open_webui/utils/nexrag_knowledge_writes.py b/backend/open_webui/utils/nexrag_knowledge_writes.py
new file mode 100644
--- /dev/null
+++ b/backend/open_webui/utils/nexrag_knowledge_writes.py
@@ -0,0 +1,56 @@
+"""One local knowledge writer across requests, background tasks and processes.
+
+Readers use immutable generations and do not acquire this lock. The ASGI scope
+includes Starlette response background tasks, so upload indexing and its final
+knowledge_file link cannot straddle a version publication.
+"""
+
+import asyncio
+import os
+from pathlib import Path
+
+from filelock import FileLock, Timeout
+from open_webui.env import DATA_DIR
+from starlette.responses import JSONResponse
+
+
+def is_knowledge_write(scope):
+    if scope['type'] != 'http' or scope.get('method') not in {'POST', 'PUT', 'PATCH', 'DELETE'}:
+        return False
+    path = scope.get('path', '')
+    return path.startswith((
+        '/api/v1/knowledge', '/api/v1/files', '/api/v1/nexrag/knowledge',
+        '/api/v1/retrieval/process', '/api/v1/retrieval/reset',
+        '/api/v1/retrieval/delete', '/api/v1/nexrag/tools/invoke',
+    ))
+
+
+class KnowledgeWriteCoordinator:
+    def __init__(self, app, timeout=600):
+        self.app = app
+        self.timeout = timeout
+
+    async def __call__(self, scope, receive, send):
+        if os.environ.get('NEXRAG_WORKSPACE') != 'true' or not is_knowledge_write(scope):
+            return await self.app(scope, receive, send)
+        directory = Path(DATA_DIR)
+        directory.mkdir(parents=True, exist_ok=True)
+        # Each request needs its own instance: a shared reentrant lock would
+        # treat unrelated coroutines on the event-loop thread as one writer.
+        lock = FileLock(str(directory / 'nexrag-knowledge-writer.lock'), thread_local=False,
+                        preserve_lock_file=True, fallback_to_soft=False)
+        deadline = asyncio.get_running_loop().time() + self.timeout
+        while True:
+            try:
+                lock.acquire(timeout=0)
+                break
+            except Timeout:
+                if asyncio.get_running_loop().time() >= deadline:
+                    return await JSONResponse(
+                        {'detail': '知识库正在更新，请稍后重试'}, status_code=409,
+                    )(scope, receive, send)
+                await asyncio.sleep(0.05)
+        try:
+            await self.app(scope, receive, send)
+        finally:
+            lock.release()
diff --git a/backend/open_webui/utils/nexrag_native_rag.py b/backend/open_webui/utils/nexrag_native_rag.py
new file mode 100644
--- /dev/null
+++ b/backend/open_webui/utils/nexrag_native_rag.py
@@ -0,0 +1,126 @@
+"""Native document bridge implemented against the local ingestion HTTP contract.
+
+WebUI owns file metadata/ACLs; the native service owns parsing, child vectors,
+and parent payloads. This adapter deliberately has no remote storage or second
+chat retrieval loop. Callers must authorize the file and target library first.
+"""
+
+import asyncio
+import os
+import tempfile
+from pathlib import Path
+from urllib.parse import urlsplit
+
+import requests
+from open_webui.env import REQUESTS_VERIFY
+from open_webui.utils.nexrag_ingestion import document_ids, remember, scoped_id
+
+
+def enabled():
+    return os.environ.get('NEXRAG_WORKSPACE') == 'true'
+
+
+def connection_settings():
+    endpoint = os.environ.get('INGESTION_API_BASE_URL', '').rstrip('/')
+    address = urlsplit(endpoint)
+    if address.scheme != 'http' or address.hostname not in {'127.0.0.1', 'localhost', '::1'} or address.username or address.password:
+        raise RuntimeError('Native ingestion requires an explicit loopback service URL')
+    key = os.environ.get('INGESTION_API_KEY', '')
+    if len(key) < 32:
+        raise RuntimeError('Native ingestion service key is missing')
+    return endpoint, {'Authorization': f'Bearer {key}'}
+
+
+def _checked(response):
+    if not 200 <= response.status_code < 300:
+        raise RuntimeError(f'Native ingestion rejected the operation ({response.status_code})')
+    return response.json()
+
+
+def index_document(path, filename, file_id, library_id, owner_id, *, edited=False):
+    """Index a private library copy; identical files in other libraries survive."""
+    endpoint, headers = connection_settings()
+    identifier = scoped_id(file_id, library_id)
+    form = {'file_id': identifier, 'filename': filename, 'collection_name': library_id,
+            'collection_type': 'knowledge', 'user_id': owner_id, 'overwrite': 'true'}
+    with Path(path).open('rb') as stream:
+        result = _checked(requests.put(
+            endpoint + '/api/v1/ingest', headers=headers, data=form,
+            files={'file': ('edited-document.txt' if edited else filename, stream)},
+            timeout=300, verify=REQUESTS_VERIFY, allow_redirects=False,
+        ))
+    if result.get('status') is not True:
+        raise RuntimeError('Native indexing did not confirm successful completion')
+    remember(file_id, library_id, identifier)
+    return result
+
+
+def extract_document(path, filename):
+    endpoint, headers = connection_settings()
+    with Path(path).open('rb') as stream:
+        body = _checked(requests.post(
+            endpoint + '/api/v1/extract', headers=headers,
+            files={'file': (filename, stream)}, timeout=120,
+            verify=REQUESTS_VERIFY, allow_redirects=False,
+        ))
+    return '\n\n'.join(document['content'] for document in body['documents'])
+
+
+def remove_document(file_id, library_id=None):
+    """Delete only the scoped copy, or each registered copy of an owned file."""
+    endpoint, headers = connection_settings()
+    for identifier in document_ids(file_id, library_id):
+        _checked(requests.delete(
+            endpoint + '/api/v1/documents/' + identifier, headers=headers,
+            timeout=120, verify=REQUESTS_VERIFY, allow_redirects=False,
+        ))
+    return True
+
+
+async def remove_library_file(file_id, library_id=None):
+    if not enabled():
+        return False
+    from open_webui.utils.nexrag_generations import library_target
+    target = await library_target(library_id) if library_id else None
+    return await asyncio.to_thread(remove_document, file_id, target)
+
+
+async def process_upload(request, file, library_id, supplied_text, actor, db):
+    """Run slow parsing/indexing outside the metadata DB transaction."""
+    from open_webui.events import EVENTS, publish_event
+    from open_webui.internal.db import get_async_db
+    from open_webui.models.files import Files
+    from open_webui.storage.provider import Storage
+    from open_webui.utils.misc import calculate_sha256_string
+    from open_webui.utils.nexrag_generations import library_target
+
+    changed = supplied_text is not None or bool((file.data or {}).get('nexrag_edited')) or not file.path
+    text = supplied_text if supplied_text is not None else (file.data or {}).get('content')
+    await db.commit()
+    temporary = None
+    try:
+        if changed:
+            text = (text or '').replace('<br/>', '\n')
+            with tempfile.NamedTemporaryFile(suffix='.txt', delete=False) as stream:
+                stream.write(text.encode('utf8'))
+                temporary = stream.name
+            source_path = temporary
+        else:
+            source_path = await asyncio.to_thread(Storage.get_file, file.path)
+            if text is None:
+                text = await asyncio.to_thread(extract_document, source_path, file.filename)
+        target = await library_target(library_id)
+        await asyncio.to_thread(index_document, source_path, file.filename, file.id,
+                                target, file.user_id, edited=changed)
+    finally:
+        if temporary:
+            Path(temporary).unlink(missing_ok=True)
+    async with get_async_db() as session:
+        await Files.update_file_data_by_id(file.id, {'content': text, 'status': 'completed',
+                                                   'error': None, 'nexrag_edited': changed}, db=session)
+        await Files.update_file_hash_by_id(file.id, calculate_sha256_string(text), db=session)
+        await Files.update_file_metadata_by_id(file.id, {'collection_name': library_id}, db=session)
+    await publish_event(request, EVENTS.RETRIEVAL_CONTENT_PROCESSED, actor=actor,
+                        subject_id=file.id, subject_type='file',
+                        data={'collection_name': library_id, 'filename': file.filename})
+    return {'status': True, 'collection_name': library_id, 'filename': file.filename, 'content': text}
diff --git a/backend/open_webui/utils/nexrag_plugin_policy.py b/backend/open_webui/utils/nexrag_plugin_policy.py
