@@ -0,0 +1,126 @@
+<script lang="ts">
+	import KnowledgePolicy from './KnowledgePolicy.svelte';
+	import { workspaceRequest } from '$lib/apis/nexrag';
+	import { toast } from 'svelte-sonner';
+	export let knowledgeId: string;
+	export let writable = false;
+	let open = false;
+	let revisions: any[] = [];
+	let note = '';
+	let busy = false;
+	let error = '';
+	let canRestore = false;
+	let restoreCandidate: any = null;
+	const load = async () => {
+		busy = true;
+		error = '';
+		try {
+			const result = await workspaceRequest(`knowledge/${knowledgeId}/versions`);
+			revisions = result.data;
+			canRestore = result.can_restore;
+		} catch (e) {
+			error = `${e}`;
+		} finally {
+			busy = false;
+		}
+	};
+	const publish = async () => {
+		busy = true;
+		try {
+			await workspaceRequest(`knowledge/${knowledgeId}/versions`, 'POST', {
+				note: note || '发布知识库版本'
+			});
+			note = '';
+			await load();
+			toast.success('版本已保存');
+		} catch (e) {
+			error = `${e}`;
+		} finally {
+			busy = false;
+		}
+	};
+	const restore = async () => {
+		if (!restoreCandidate || busy) return;
+		busy = true;
+		error = '';
+		try {
+			await workspaceRequest(
+				`knowledge/${knowledgeId}/versions/${restoreCandidate.id}/restore`,
+				'POST'
+			);
+			toast.success('历史版本已恢复，并保存为新版本');
+			window.location.reload();
+		} catch (e) {
+			error = `${e}`;
+		} finally {
+			busy = false;
+		}
+	};
+</script>
+
+<KnowledgePolicy {knowledgeId} />
+<section class="mx-3 my-3 rounded-lg border border-gray-200 dark:border-gray-800 text-sm">
+	<button
+		class="w-full flex justify-between p-3 text-left"
+		aria-expanded={open}
+		on:click={() => {
+			open = !open;
+			if (open) load();
+		}}
+		><span>知识库版本与更新记录</span><span class="text-xs text-gray-500"
+			>{writable ? '维护与发布' : '只读 · 跟随授权更新'} {open ? '−' : '+'}</span
+		></button
+	>
+	{#if open}<div class="p-3 pt-0 space-y-3">
+			<p class="text-xs text-gray-500">
+				内容更新会自动记录版本。授权账号跟随知识库的当前内容。所有者可以恢复历史名称、说明与文件，恢复前自动保存当前版本；恢复沿用当前权限，历史快照不包含文件夹布局。
+			</p>
+			{#if error}<p role="alert" class="text-red-500">{error}</p>{/if}
+			{#if restoreCandidate}<div
+					role="group"
+					aria-label="确认恢复历史版本"
+					class="rounded-lg border border-amber-300 p-3 space-y-2"
+				>
+					<p>将恢复「{restoreCandidate.note}」，并保存为新版本。当前版本和权限记录会保留。</p>
+					<div class="flex gap-4">
+						<button class="text-blue-600" disabled={busy} on:click={restore}
+							>{busy ? '正在恢复，请勿重复提交…' : '确认恢复为新版本'}</button
+						><button disabled={busy} on:click={() => (restoreCandidate = null)}>取消恢复</button>
+					</div>
+				</div>{/if}
+			{#if writable}<form class="flex gap-2" on:submit|preventDefault={publish}>
+					<input
+						class="flex-1 min-w-0 rounded-lg border border-gray-200 dark:border-gray-750 bg-transparent p-2 text-sm"
+						aria-label="版本更新说明"
+						placeholder="填写本次更新说明"
+						bind:value={note}
+						maxlength="300"
+					/><button class="text-blue-600 shrink-0" disabled={busy}>发布版本</button>
+				</form>{/if}
+			{#each revisions as revision}<div
+					class="flex justify-between gap-3 border-t border-gray-100 dark:border-gray-800 py-2"
+				>
+					<div>
+						<p>{revision.note}</p>
+						<p class="text-xs text-gray-500 mt-1">
+							{new Date(revision.created_at * 1000).toLocaleString()} · {revision.body.files.length} 个文件
+							· {revision.id.slice(0, 8)}
+						</p>
+					</div>
+					<div class="flex gap-3 items-start">
+						<a
+							class="text-blue-600 shrink-0"
+							href={`/api/v1/nexrag/knowledge/${knowledgeId}/versions/${revision.id}/download`}
+							download={`knowledge-${revision.id.slice(0, 8)}.zip`}>下载版本</a
+						>{#if writable && canRestore}<button
+								class="text-blue-600 shrink-0"
+								aria-label={`恢复版本 ${revision.id.slice(0, 8)}`}
+								disabled={busy}
+								on:click={() => (restoreCandidate = revision)}>恢复此版本</button
+							>{/if}
+					</div>
+				</div>{:else}<p class="text-xs text-gray-500 py-2">
+					{busy ? '正在读取版本…' : '尚无版本记录，首次更新或发布后开始记录。'}
+				</p>{/each}
+		</div>{/if}
+</section>
diff --git a/src/lib/components/nexrag/McpManager.svelte b/src/lib/components/nexrag/McpManager.svelte
new file mode 100644
