+"""NexRAG workspace policy on top of Open WebUI's ownership and access grants."""
+
+import os
+
+from fastapi import Depends, HTTPException, Request
+from open_webui.models.config import Config
+from open_webui.models.groups import Groups
+from open_webui.models.knowledge import Knowledges
+from open_webui.models.users import Users
+from open_webui.utils.auth import get_verified_user
+
+
+async def readable_knowledge(user):
+    groups = await Groups.get_groups_by_member_id(user.id)
+    result = await Knowledges.search_knowledge_bases(
+        user.id, filter={'user_id': user.id, 'group_ids': [group.id for group in groups]}, skip=0, limit=500
+    )
+    return result.items
+
+
+async def knowledge_scopes(user):
+    from open_webui.utils.nexrag_generations import collection_for
+    return [collection_for(item) for item in await readable_knowledge(user)]
+
+
+async def resource_owner(resource_type, identifier, db=None):
+    from open_webui.models.files import Files
+    from open_webui.models.models import Models
+    from open_webui.models.skills import Skills
+    from open_webui.models.tools import Tools
+
+    getters = {'knowledge': Knowledges.get_knowledge_by_id, 'model': Models.get_model_by_id,
+               'skill': Skills.get_skill_by_id, 'tool': Tools.get_tool_by_id, 'file': Files.get_file_by_id}
+    getter = getters.get(resource_type)
+    resource = await getter(identifier, db=db) if getter else None
+    return await Users.get_user_by_id(resource.user_id, db=db) if resource else None
+
+
+async def guard_managed_write(request: Request, user=Depends(get_verified_user)):
+    if user.role == 'admin' or request.method not in {'POST', 'PUT', 'PATCH', 'DELETE'}:
+        return
+    resource_type = {'knowledge': 'knowledge', 'models': 'model', 'skills': 'skill',
+                     'tools': 'tool', 'files': 'file'}.get(request.url.path.split('/')[3])
+    identifier = request.path_params.get('id')
+    if not identifier and resource_type == 'model':
+        try:
+            body = await request.json()
+            identifier = body.get('id') if isinstance(body, dict) else None
+        except ValueError:
+            pass
+    if not identifier or request.url.path.endswith(('/search', '/query', '/retrieve')):
+        return
+    owner = await resource_owner(resource_type, identifier)
+    if owner and owner.role == 'admin' and owner.id != user.id:
+        raise HTTPException(403, '管理员下发的资源为只读，请联系管理员更新')
+
+
+async def managed_grants(resource_type, identifier, grants, db):
+    owner = await resource_owner(resource_type, identifier, db=db)
+    if owner and owner.role == 'admin' and resource_type in {'knowledge', 'model', 'skill', 'tool'}:
+        return [{**grant, 'permission': 'read'} for grant in grants]
+    return grants
+
+
+async def apply_workspace_profile():
+    if os.environ.get('NEXRAG_WORKSPACE') != 'true':
+        return
+    # All provider credentials and model selection belong to the core registry.
+    # Retained upstream provider URLs would bypass its per-user data policies.
+    endpoint = os.environ.get('NEXRAG_API_BASE_URL')
+    if endpoint:
+        await Config.upsert({
+            'openai.enable': True,
+            'openai.api_base_urls': [endpoint],
+            'openai.api_keys': [os.environ.get('NEXRAG_SHARED_API_KEY', '')],
+            'openai.api_configs': {'0': {'enable': True, 'prefix_id': '', 'model_ids': []}},
+        })
+    await Config.upsert({'direct.enable': False, 'direct.integrations.enable': False,
+                         'web.search.enable': False, 'tool_server.connections': [],
+                         'terminal_server.connections': [], 'memories.enable': False})
+    # Auxiliary chat titles/tags/follow-ups must not start extra Agent analyses.
+    # Conversation naming remains available through the existing chat menu.
+    await Config.upsert({'task.title.enable': False, 'task.tags.enable': False,
+                         'task.follow_up.enable': False})
+    if await Config.get('nexrag.workspace_profile') == 2:
+        return
+    permissions = await Config.get('user.permissions') or {}
+    permissions = {**permissions, 'workspace': {**permissions.get('workspace', {}),
+                                               'models': True, 'knowledge': True, 'skills': True, 'tools': True},
+                   'features': {**permissions.get('features', {}), 'notes': True, 'automations': True}}
+    await Config.upsert({'notes.enable': True, 'automations.enable': True, 'calendar.enable': False,
+                         'channels.enable': False, 'evaluation.arena.enable': False,
+                         'user.permissions': permissions, 'nexrag.workspace_profile': 2,
+                         'ui.default_models': 'nexrag-model-default',
+                         'ui.prompt_suggestions': [
+                             {'title': ['分析业务数据', '在获授权范围内查询和核对指标'], 'content': '查看我已授权业务数据的表结构，说明可以进行哪些分析。'},
+                             {'title': ['查阅企业知识', '从个人及授权知识库中寻找依据'], 'content': '检索我可访问的知识库，概括主要内容并引用来源。'},
+                             {'title': ['生成分析报告', '结合业务数据与文档输出报告'], 'content': '结合我当前授权的业务数据和知识库，生成一份有来源依据的分析报告并导出文件。'},
+                         ]})
