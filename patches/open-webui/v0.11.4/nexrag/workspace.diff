+<script lang="ts">
+	import { onMount } from 'svelte';
+	import { request } from '$lib/apis/nexrag';
+	let policies: any[] = [];
+	let error = '';
+	let saved = '';
+	async function save(policy: any) {
+		error = '';
+		saved = '';
+		if (policy.classification === 'secret') {
+			policy.external_models = false;
+			policy.external_search = false;
+			policy.external_tools = false;
+		}
+		if (policy.classification !== 'public') policy.external_search = false;
+		try {
+			await request(
+				localStorage.token,
+				`workspace/policy/tenants/${encodeURIComponent(policy.resource_id)}`,
+				'POST',
+				policy
+			);
+			saved = `${policy.label} 的保护策略已保存`;
+		} catch (cause) {
+			error = String(cause);
+		}
+	}
+	onMount(async () => {
+		try {
+			policies = (await request(localStorage.token, 'workspace/policy')).tenants;
+		} catch (cause) {
+			error = String(cause);
+		}
+	});
+</script>
+
+<section class="space-y-4">
+	<div>
+		<h2 class="font-medium">业务数据分级与处理范围</h2>
+		<p class="mt-2 text-sm text-gray-500">
+			账号有权读取数据，不代表可以向外发送。外部模型必须同时满足账号清单和数据策略；核心机密禁止外发。
+		</p>
+	</div>
+	{#if error}<p role="alert" class="text-sm text-red-600">{error}</p>{/if}
+	{#if saved}<p role="status" class="text-sm text-green-600">{saved}</p>{/if}
+	{#each policies as policy}<form
+			class="rounded-xl border border-gray-200 p-4 text-sm dark:border-gray-750 space-y-3"
+			on:submit|preventDefault={() => save(policy)}
+		>
+			<div class="flex flex-wrap items-center justify-between gap-3">
+				<h3 class="font-medium">{policy.label}</h3>
+				<label
+					>分级<select
+						class="ml-3 rounded-lg border border-gray-300 bg-transparent p-2 dark:border-gray-700"
+						bind:value={policy.classification}
+						><option value="public">公开</option><option value="internal">内部</option><option
+							value="secret">核心机密 · 仅本机</option
+						></select
+					></label
+				>
+			</div>
+			<label class="flex items-center gap-2"
+				><input
+					type="checkbox"
+					bind:checked={policy.external_models}
+					disabled={policy.classification === 'secret'}
+				/>允许账号授权清单中的外部模型</label
+			>
+			<label class="flex items-center gap-2"
+				><input
+					type="checkbox"
+					bind:checked={policy.external_search}
+					disabled={policy.classification !== 'public'}
+				/>允许公开信息用于外部搜索</label
+			>
+			<label class="flex items-center gap-2"
+				><input
+					type="checkbox"
+					bind:checked={policy.external_tools}
+					disabled={policy.classification === 'secret'}
+				/>允许已审批的外部工具处理</label
+			>
+			<button class="text-blue-600">保存数据保护策略</button>
+		</form>{/each}
+</section>
