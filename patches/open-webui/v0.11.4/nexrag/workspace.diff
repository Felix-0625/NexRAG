@@ -0,0 +1,57 @@
+"""Knowledge classification and live authorization for the local Agent."""
+import hmac
+import os
+
+from fastapi import APIRouter, Depends, Header, HTTPException
+from open_webui.models.users import Users
+from open_webui.utils.auth import get_verified_user
+from open_webui.utils.nexrag_knowledge_policy import DEFAULT_POLICY, labels_for, policy_for, update_policy
+from open_webui.utils.nexrag_privacy import require_knowledge
+from pydantic import BaseModel, Field
+
+router = APIRouter()
+
+
+class KnowledgePolicyForm(BaseModel):
+    classification: str = Field(pattern='^(public|internal|secret)$')
+    external_models: bool = False
+    external_search: bool = False
+    external_tools: bool = False
+    enterprise_all: bool = False
+
+
+@router.get('/knowledge/{identifier}/policy')
+async def knowledge_policy(identifier: str, user=Depends(get_verified_user)):
+    knowledge = await require_knowledge(identifier, user)
+    return {**policy_for(knowledge), 'enterprise_all': bool((knowledge.meta or {}).get('nexrag_enterprise_all')),
+            'can_manage': knowledge.user_id == user.id, 'is_admin': user.role == 'admin'}
+
+
+@router.post('/knowledge/{identifier}/policy')
+async def save_knowledge_policy(identifier: str, body: KnowledgePolicyForm, user=Depends(get_verified_user)):
+    knowledge = await require_knowledge(identifier, user, write=True)
+    policy = {key: getattr(body, key) for key in DEFAULT_POLICY}
+    return await update_policy(knowledge, user, policy, body.enterprise_all)
+
+
+class AuthorizationForm(BaseModel):
+    user_id: str = Field(max_length=128)
+    attachment_ids: list[str] = Field(default_factory=list, max_length=30)
+
+
+@router.post('/authorization/check')
+async def authorization_snapshot(body: AuthorizationForm, authorization: str = Header(default='')):
+    secret = os.environ.get('NEXRAG_SHARED_API_KEY', '')
+    if not secret or not hmac.compare_digest(authorization, f'Bearer {secret}'):
+        raise HTTPException(401, '无效的服务身份')
+    user = await Users.get_user_by_id(body.user_id)
+    if not user or user.role not in {'user', 'admin'}:
+        raise HTTPException(403, '账号已停用')
+    from open_webui.utils.nexrag_identity import state
+    if state(user.id)['must_change_password']:
+        raise HTTPException(403, '必须先修改初始密码')
+    labels = await labels_for(user)
+    from open_webui.utils.nexrag_attachments import attachment_labels
+    labels.update(await attachment_labels(user, body.attachment_ids))
+    return {'knowledge_scopes': list(labels), 'knowledge_labels': labels, 'role': user.role, 'email': user.email,
+            'session_version': state(user.id)['session_version']}
