+	const button = 'rounded-lg bg-gray-900 text-white dark:bg-gray-100 dark:text-gray-900 px-4 py-2 text-sm disabled:opacity-40';
+	const providerName = (id: string) => providers.find((item) => item.id === id)?.label ?? id;
+	async function load(refresh = false) {
+		error = '';
+		try {
+			entries = (await request(localStorage.token, 'workspace/models')).data;
+			workspaceCounts.update((counts) => ({...counts, models: entries.filter((item) => item.enabled).length}));
+			if (refresh) models.set(await getModels(localStorage.token, null, false, true));
+		} catch (e) {error = `${e}`;} finally {loading = false;}
+	}
+	function edit(item: any = null) {
+		editing = item;
+		form = item ? {...blank(), ...item, api_key: '', clear_api_key: false} : blank();
+		showForm = true; error = ''; testResult = '';
+		accountSearch = ''; accountsError = '';
+		workspaceRequest('directory').then((value) => {accounts = value.users;}).catch((cause) => {accountsError = `${cause}`;});
+	}
+	function changeProvider() {
+		const preset = providers.find((item) => item.id === form.provider)!;
+		form.base_url = preset.url; form.protocol = preset.protocol;
+		form.api_key = ''; form.clear_api_key = false;
+	}
+	async function save() {
+		busy = true; error = '';
+		try {
+			await request(localStorage.token, `workspace/models${editing ? '/' + editing.id : ''}`, 'POST', form);
+			form.api_key = ''; showForm = false; editing = null;
+			await load(true); toast.success('模型已保存，对话列表已更新');
+		} catch (e) {error = `${e}`;} finally {busy = false;}
+	}
+	async function makeDefault(item: any) {
+		busy = true; error = '';
+		try {
+			await request(localStorage.token, `workspace/models/${item.id}/default`, 'POST', {});
+			config.update((value) => ({...value, default_models: item.id}));
+			await load(true); toast.success('默认对话模型已更新');
+		} catch (e) {error = `${e}`;} finally {busy = false;}
+	}
+	async function test(item: any) {
+		testId = item.id; testResult = ''; error = '';
+		try {testResult = (await request(localStorage.token, `workspace/models/${item.id}/test`, 'POST', {})).message;}
+		catch (e) {error = `${e}`;} finally {testId = '';}
+	}
+	onMount(() => load());
+</script>
+
+<div class="w-full max-w-5xl mx-auto p-3 sm:p-5 space-y-5">
+	<div class="flex items-start justify-between gap-4">
+		<div><h1 class="text-lg font-semibold">对话模型</h1><p class="text-sm text-gray-500 mt-2">为 NexRAG 的单 Agent 配置实际模型。切换模型后，继续使用相同的数据库、知识库与工具权限。</p></div>
