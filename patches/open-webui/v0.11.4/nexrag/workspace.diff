+    base_url = os.environ.get('NEXRAG_API_BASE_URL', '').rstrip('/')
+    service_key = os.environ.get('NEXRAG_SHARED_API_KEY', '')
+    jwt_secret = os.environ.get('FORWARD_USER_INFO_HEADER_JWT_SECRET', '')
+    if not base_url or len(service_key) < 32 or len(jwt_secret) < 32:
+        raise HTTPException(status_code=503, detail='NexRAG tenant service is not configured')
+
+    headers = include_user_info_headers(
+        {'Authorization': f'Bearer {service_key}'}, user, request=request
+    )
