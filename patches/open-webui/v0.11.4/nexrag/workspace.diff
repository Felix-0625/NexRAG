+++ b/src/lib/components/nexrag/McpManager.svelte
@@ -0,0 +1,175 @@
+<script lang="ts">
+	import { onMount } from 'svelte';
+	import { request } from '$lib/apis/nexrag';
+	let servers: any[] = [];
+	let error = '',
+		message = '';
+	let busy = false;
+	let form = {
+		identifier: null as string | null,
+		name: '',
+		url: '',
+		token: '',
+		clear_token: false,
+		enabled: true
+	};
+	let reviewed: Record<string, boolean> = {};
+	const api = (path = '', method = 'GET', body?: object) =>
+		request(localStorage.token, `workspace/mcp${path}`, method, body);
+	async function load() {
+		servers = (await api()).data;
+	}
+	async function action(task: () => Promise<void>) {
+		busy = true;
+		error = '';
+		message = '';
+		try {
+			await task();
+			await load();
+		} catch (cause) {
+			error = String(cause);
+		} finally {
+			busy = false;
+		}
+	}
+	async function save() {
+		await api('', 'POST', { ...form, token: form.token || null });
+		form = { identifier: null, name: '', url: '', token: '', clear_token: false, enabled: true };
+		message = '连接已保存。请发现工具并逐项审批后，再为员工分发。';
+	}
+	function edit(server: any) {
+		form = {
+			identifier: server.id,
+			name: server.name,
+			url: server.url,
+			token: '',
+			clear_token: false,
+			enabled: server.enabled
+		};
+	}
+	onMount(() => action(load));
+	const field =
+		'mt-2 block w-full rounded-lg border border-gray-300 bg-transparent p-2.5 text-sm dark:border-gray-700';
+</script>
+
+<section class="space-y-5 border-t border-gray-200 pt-6 dark:border-gray-750">
+	<header>
+		<h2 class="text-lg font-medium">MCP 连接与工具审批</h2>
+		<p class="mt-2 text-sm text-gray-500">
+			为单个 Agent 接入固定的只读工具。远程使用 HTTPS，本机允许回环 HTTP；不运行命令或源码。
+		</p>
+		<p class="mt-2 text-xs text-gray-500">
+			审批后仍需按账号分发。当前业务范围和所有可读知识库必须同时允许外部工具；核心机密始终禁止发送。工具服务需要部署者确认可信。
+		</p>
+	</header>
+	{#if error}<p role="alert" class="text-sm text-red-600">{error}</p>{/if}
+	{#if message}<p role="status" class="text-sm text-green-600">{message}</p>{/if}
+	<form
+		class="space-y-4 rounded-xl border border-gray-200 p-4 dark:border-gray-750"
+		on:submit|preventDefault={() => action(save)}
+	>
+		<h3 class="font-medium">{form.identifier ? '编辑连接' : '添加连接'}</h3>
+		<label class="block text-sm"
+			>连接名称<input class={field} bind:value={form.name} required maxlength="100" /></label
+		>
+		<label class="block text-sm"
+			>服务地址<input
+				class={field}
+				type="url"
+				bind:value={form.url}
+				placeholder="https://example.com/mcp"
+				required
+			/></label
+		>
+		<label class="block text-sm"
+			>服务访问令牌（可选）<input
+				class={field}
+				type="password"
+				autocomplete="off"
+				bind:value={form.token}
+				placeholder={form.identifier ? '留空保留现有令牌' : '无认证的本机服务可留空'}
+			/></label
+		>
+		<div class="flex flex-wrap gap-4 text-sm">
+			<label><input type="checkbox" bind:checked={form.enabled} /> 启用连接</label><label
+				><input type="checkbox" bind:checked={form.clear_token} /> 清除已有令牌</label
+			>
+		</div>
+		<p class="text-xs text-gray-500">
+			保存连接会使旧审批失效；更换地址不会自动把旧令牌发送到新地址。令牌加密保存，页面不回显。
+		</p>
+		<button
+			class="rounded-lg bg-blue-600 px-4 py-2 text-sm text-white disabled:opacity-50"
+			disabled={busy}>保存连接</button
+		>
+	</form>
+	{#each servers as server}
+		<article class="space-y-4 rounded-xl border border-gray-200 p-4 dark:border-gray-750">
+			<div class="flex flex-wrap justify-between gap-3">
+				<div>
+					<h3 class="font-medium">{server.name} · {server.enabled ? '启用' : '停用'}</h3>
+					<p class="mt-1 break-all text-xs text-gray-500">{server.url}</p>
+				</div>
+				<div class="flex gap-3 text-sm">
+					<button class="text-blue-600" disabled={busy} on:click={() => edit(server)}
+						>编辑连接</button
+					><button
+						class="text-blue-600"
+						disabled={busy || !server.enabled}
+						on:click={() =>
+							action(async () => {
+								await api(`/${server.id}/discover`, 'POST', {});
+								reviewed = {};
+								message = '已读取当前工具；变化的工具需要重新审批。';
+							})}>发现工具</button
+					>
+				</div>
+			</div>
