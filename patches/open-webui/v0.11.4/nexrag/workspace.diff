+"""Workspace access and version history, reusing upstream identity and ACLs."""
+
+import io
+import asyncio
+import json
+import zipfile
+from pathlib import Path
+
+from fastapi import APIRouter, Depends, HTTPException, Header
+from fastapi.responses import Response
+from open_webui.models.access_grants import AccessGrants
+from open_webui.models.knowledge import Knowledges
+from open_webui.models.users import Users
+from open_webui.utils.auth import get_verified_user
+from open_webui.utils.nexrag_versions import (
+    ArchiveIntegrityError, list_revisions, record_revision, revision_history, verified_archive_files,
+)
+from open_webui.utils.nexrag_workspace import readable_knowledge
+from pydantic import BaseModel, Field
+
+router = APIRouter()
+
+
+class ToolCallForm(BaseModel):
+    ticket: str = Field(max_length=128)
+    name: str = Field(max_length=150)
+    arguments: dict
+    user_id: str = Field(max_length=128)
+
+
+@router.post('/tools/invoke')
+async def invoke_tool(body: ToolCallForm, authorization: str = Header(default='')):
+    from open_webui.utils.nexrag_tool_bridge import invoke
+    return {'result': await invoke(body.ticket, body.name, body.arguments, body.user_id, authorization)}
+
+
+@router.post('/session/pause')
+async def pause_session(response: Response, user=Depends(get_verified_user)):
+    """Clear this browser's active cookie while retaining remembered sessions."""
+    response.delete_cookie('token')
+    return {'ok': True}
+
+
+@router.get('/access')
+async def workspace_access(user=Depends(get_verified_user)):
+    items = []
+    for knowledge in await readable_knowledge(user):
+        owner = await Users.get_user_by_id(knowledge.user_id)
+        items.append({'id': knowledge.id, 'name': knowledge.name, 'owner_id': knowledge.user_id,
+                      'managed': bool(owner and owner.role == 'admin' and owner.id != user.id),
+                      'mine': knowledge.user_id == user.id, 'updated_at': knowledge.updated_at})
+    return {'knowledge': items}
+
+
+async def verify_knowledge(identifier, user, write=False):
+    from open_webui.utils.nexrag_privacy import private_workspace, require_knowledge
+    if private_workspace():
+        return await require_knowledge(identifier, user, write)
+    knowledge = await Knowledges.get_knowledge_by_id(identifier)
+    if not knowledge:
+        raise HTTPException(404, '知识库不存在')
+    if knowledge.user_id != user.id:
+        owner = await Users.get_user_by_id(knowledge.user_id)
+        if write and owner and owner.role == 'admin' and user.role != 'admin':
+            raise HTTPException(403, '管理员下发的知识库只读')
+        if user.role != 'admin' and not await AccessGrants.has_access(user.id, 'knowledge', identifier, 'write' if write else 'read'):
+            raise HTTPException(403, '没有此知识库的访问权限')
+    return knowledge
+
+
+@router.get('/knowledge/{identifier}/versions')
+async def history(identifier: str, user=Depends(get_verified_user)):
+    knowledge = await verify_knowledge(identifier, user)
+    return {'data': revision_history(knowledge), 'can_restore': knowledge.user_id == user.id}
+
+
+class PublishForm(BaseModel):
+    note: str = Field(default='发布知识库版本', max_length=300)
+
+
+@router.post('/knowledge/{identifier}/versions')
+async def publish(identifier: str, body: PublishForm, user=Depends(get_verified_user)):
+    await verify_knowledge(identifier, user, write=True)
+    try:
+        return {'id': await record_revision(identifier, user.id, body.note, force=True)}
+    except ArchiveIntegrityError as error:
+        raise HTTPException(409, str(error)) from error
+
+
+@router.get('/knowledge/{identifier}/versions/{revision}/download')
+async def download_revision(identifier: str, revision: str, user=Depends(get_verified_user)):
+    knowledge = await verify_knowledge(identifier, user)
+    item = next((row for row in revision_history(knowledge) if row['id'] == revision), None)
+    if not item:
+        raise HTTPException(404, '版本不存在')
+    try:
+        files = await asyncio.to_thread(verified_archive_files, item['body'])
+    except ArchiveIntegrityError as error:
+        raise HTTPException(409, str(error)) from error
+    buffer = io.BytesIO()
+    with zipfile.ZipFile(buffer, 'w', zipfile.ZIP_DEFLATED) as archive:
+        archive.writestr('manifest.json', json.dumps(item['body'], ensure_ascii=False, indent=2))
+        for index, (file, path) in enumerate(files):
+            archive.write(path, f'files/{index + 1}-{Path(file["filename"]).name}')
+    return Response(buffer.getvalue(), media_type='application/zip',
+                    headers={'Content-Disposition': f'attachment; filename="knowledge-{revision[:8]}.zip"'})
+
+
+@router.post('/knowledge/{identifier}/versions/{revision}/restore')
+async def restore(identifier: str, revision: str, user=Depends(get_verified_user)):
+    knowledge = await verify_knowledge(identifier, user, write=True)
+    from open_webui.utils.nexrag_restore import restore_revision
+    try:
+        return await restore_revision(knowledge, revision, user)
+    except ArchiveIntegrityError as error:
+        raise HTTPException(409, str(error)) from error
+    except (OSError, RuntimeError, ValueError) as error:
+        raise HTTPException(503, '恢复未发布，原版本保持可用；请检查本机检索服务后重试') from error
diff --git a/backend/open_webui/utils/nexrag_attachments.py b/backend/open_webui/utils/nexrag_attachments.py
new file mode 100644
--- /dev/null
+++ b/backend/open_webui/utils/nexrag_attachments.py
@@ -0,0 +1,56 @@
+"""Resolve chat attachment references from current file ACLs, never browser metadata."""
+
+import re
+
+from fastapi import HTTPException
+from open_webui.models.knowledge import Knowledges
+from open_webui.utils.nexrag_knowledge_policy import DEFAULT_POLICY
+from open_webui.utils.nexrag_privacy import require_file, require_knowledge
+
+
+def attachment_ids(items):
+    """Accept local uploaded file references; collection refs use the KB ACL path."""
+    identifiers = []
+    for item in items or []:
+        if not isinstance(item, dict):
+            raise HTTPException(400, '附件标识无效')
+        if item.get('type') not in {'file', 'text'}:
+            continue
+        nested = item.get('file') if isinstance(item.get('file'), dict) else {}
+        identifier = item.get('id') or nested.get('id')
+        if not isinstance(identifier, str) or not re.fullmatch(r'[A-Za-z0-9_-]{1,123}', identifier):
+            raise HTTPException(400, '请上传本机文件后再添加附件')
+        if identifier not in identifiers:
+            identifiers.append(identifier)
+    if len(identifiers) > 30:
+        raise HTTPException(400, '单次对话最多引用30份附件')
+    return identifiers
+
+
+async def attachment_labels(user, identifiers):
+    """Each refresh checks owner/explicit ACL, including administrators.
+
+    A filename or client collection_name does not grant access. Unclassified
+    chat files are internal and cannot be sent to cloud models, search or MCP.
+    Existing secret KB labels remain in the joint resource policy as well.
+    """
+    labels = {}
+    for identifier in identifiers:
+        if not isinstance(identifier, str) or not re.fullmatch(r'[A-Za-z0-9_-]{1,123}', identifier):
+            raise HTTPException(400, '附件标识无效')
+        await require_file(identifier, user)
+        libraries = await Knowledges.get_knowledges_by_file_id(identifier)
+        readable = []
+        for library in libraries:
+            try:
+                await require_knowledge(library.id, user)
+                readable.append(library.id)
+            except HTTPException as exc:
+                if exc.status_code != 404:
+                    raise
+        if readable:
+            # Retrieve the live KB copy, not an older file-* upload shadow.
+            # Its signed policy is already supplied by labels_for(user).
+            continue
+        labels[f'file-{identifier}'] = dict(DEFAULT_POLICY)
+    return labels
