@@ -0,0 +1,17 @@
+"""Separate business administration from arbitrary host-code execution.
+
+Trusted plugins are deployment extensions, not an employee or business-admin
+capability. Enabling them gives their author the WebUI process's filesystem and
+network privileges; ACLs cannot sandbox arbitrary Python code.
+"""
+
+import os
+
+
+def trusted_plugins_enabled():
+    return os.environ.get('NEXRAG_WORKSPACE') != 'true' or os.environ.get('NEXRAG_ALLOW_TRUSTED_PLUGINS') == 'true'
+
+
+def require_trusted_plugin_execution():
+    if not trusted_plugins_enabled():
+        raise PermissionError('本地模式默认禁止执行 Python 源码插件；部署者须显式启用受信任插件模式')
diff --git a/backend/open_webui/utils/nexrag_privacy.py b/backend/open_webui/utils/nexrag_privacy.py
new file mode 100644
--- /dev/null
+++ b/backend/open_webui/utils/nexrag_privacy.py
@@ -0,0 +1,98 @@
+"""Content ownership/ACLs, including administrators, in the NexRAG workspace."""
+
+import os
+
+from fastapi import Depends, HTTPException, Request
+from open_webui.models.access_grants import AccessGrants
+from open_webui.models.files import Files
+from open_webui.models.knowledge import Knowledges
+from open_webui.utils.auth import get_verified_user
+
+
+def private_workspace():
+    return os.environ.get('NEXRAG_WORKSPACE') == 'true'
+
+
+def admin_content_bypass(user):
+    role = user.get('role') if isinstance(user, dict) else user.role
+    return role == 'admin' and not private_workspace()
+
+
+def protect_private_response(request, response):
+    if private_workspace() and request.url.path.startswith((
+        '/api/v1/files', '/api/v1/knowledge', '/api/v1/retrieval', '/api/v1/notes',
+        '/api/v1/nexrag/knowledge',
+        '/api/v1/nexrag/directory', '/api/nexrag/workspace/directory',
+    )):
+        response.headers['Cache-Control'] = 'private, no-store, max-age=0'
+        response.headers['Pragma'] = 'no-cache'
+        response.headers['Vary'] = 'Authorization, Cookie'
+    return response
+
+
+async def require_knowledge(identifier, user, write=False):
+    knowledge = await Knowledges.get_knowledge_by_id(identifier)
+    if not knowledge or not (
+        knowledge.user_id == user.id or await AccessGrants.has_access(
+            user.id, 'knowledge', identifier, 'write' if write else 'read'
+        )
+    ):
+        # Do not disclose even the existence of another user's private resource.
+        raise HTTPException(404, '知识库不存在或未获授权')
+    return knowledge
+
+
+async def require_file(identifier, user, write=False):
+    from open_webui.utils.access_control.files import has_access_to_file
+    file = await Files.get_file_by_id(identifier)
+    if not file or not (file.user_id == user.id or await has_access_to_file(
+        identifier, 'write' if write else 'read', user
+    )):
+        raise HTTPException(404, '文件不存在或未获授权')
+    return file
+
+
+async def guard_private_resources(request: Request, user=Depends(get_verified_user)):
+    if not private_workspace():
+        return
+    path = request.url.path
+    if path in {'/api/v1/files/all', '/api/v1/retrieval/reset/db',
+                '/api/v1/retrieval/reset/uploads', '/api/v1/retrieval/delete'}:
+        raise HTTPException(403, '禁止全局清除私人内容，请在自己的知识库中逐项管理')
+    write = request.method not in {'GET', 'HEAD'}
+    identifier = request.path_params.get('id')
+    if identifier and path.startswith('/api/v1/knowledge/'):
+        await require_knowledge(identifier, user, write)
+    elif identifier and path.startswith('/api/v1/files/'):
+        await require_file(identifier, user, write)
+    # File/collection IDs in a JSON payload are references, never authority.
+    if request.method == 'POST' and path.startswith(('/api/v1/knowledge/', '/api/v1/retrieval/')):
+        try:
+            body = await request.json()
+        except (ValueError, UnicodeDecodeError):
+            return
+        if not isinstance(body, dict):
+            return
+        query = '/query/' in path
+        file_ids = [body['file_id']] if isinstance(body.get('file_id'), str) else []
+        for item in body.get('files', []) if isinstance(body.get('files'), list) else []:
+            if isinstance(item, dict) and isinstance(item.get('id'), str):
+                file_ids.append(item['id'])
+        file_ids.extend(body.get('file_ids', []) if isinstance(body.get('file_ids'), list) else [])
+        for file_id in file_ids:
+            if not isinstance(file_id, str):
+                raise HTTPException(400, '文件标识无效')
+            await require_file(file_id, user, bool(body.get('content') is not None))
+        collections = body.get('collection_names', [])
+        collections = collections if isinstance(collections, list) else []
+        if isinstance(body.get('collection_name'), str):
+            collections.append(body['collection_name'])
+        for collection in collections:
+            if not isinstance(collection, str):
+                raise HTTPException(400, '知识库标识无效')
+            if collection.startswith('file-'):
+                await require_file(collection[5:], user, not query)
+            elif await Knowledges.get_knowledge_by_id(collection):
+                await require_knowledge(collection, user, not query)
+            elif not collection.startswith(f'web-search-{user.id}-'):
+                raise HTTPException(404, '未授权的文档集合')
diff --git a/backend/open_webui/utils/nexrag_restore.py b/backend/open_webui/utils/nexrag_restore.py
new file mode 100644
--- /dev/null
+++ b/backend/open_webui/utils/nexrag_restore.py
@@ -0,0 +1,156 @@
+"""Stage a complete native index and publish restored files in one DB commit.
+
+The request is covered by KnowledgeWriteCoordinator, including upload background
+tasks. Never update existing File rows: a file may also belong to another KB.
+Existing content, indexes, ACLs and history remain available until publication.
+"""
+
+import asyncio
+import hashlib
+import logging
+import time
+import uuid
+from pathlib import Path
+
+from fastapi import HTTPException
+from open_webui.internal.db import get_async_db
+from open_webui.models.files import File
+from open_webui.models.knowledge import Knowledge, KnowledgeFile, Knowledges
+from open_webui.storage.provider import Storage
+from open_webui.utils.nexrag_native_rag import (
+    enabled, extract_document, index_document, remove_document,
+)
+from open_webui.utils.nexrag_versions import (
+    ArchiveIntegrityError, record_revision, revision_history, verified_archive_files,
+)
+from sqlalchemy import delete, select
+
+log = logging.getLogger(__name__)
+
+
+async def finished_io(function, *args):
+    """An abandoned HTTP task must not race cleanup with a still-running PUT."""
+    task = asyncio.create_task(asyncio.to_thread(function, *args))
+    try:
+        return await asyncio.shield(task)
+    except asyncio.CancelledError:
+        try:
+            await task
+        finally:
+            raise
+
+
+def copy_archived_file(path, identifier, filename):
+    name = Path(filename.replace('\\', '/')).name
+    if not name or name in {'.', '..'}:
+        raise ArchiveIntegrityError('版本文件名无效')
+    with path.open('rb') as stream:
+        _, stored = Storage.upload_file(stream, f'{identifier}_{name}', {})
+    return stored
+
+
+async def publish_restored_files(knowledge, body, files, generation, actor_id, source_revision):
+    """The file set, target index and restore audit become visible atomically."""
+    now = int(time.time())
+    revision_id = uuid.uuid4().hex
+    restored = {
+        'id': revision_id, 'created_at': time.time(), 'created_by': actor_id,
+        'note': f'恢复历史版本 {source_revision[:8]}', 'restored_from': source_revision,
+        'body': {'name': body['name'], 'description': body['description'],
+                 'files': [item['archive'] for item in files]},
+    }
+    async with get_async_db() as db:
+        async with db.begin():
+            current = (await db.execute(select(Knowledge).where(Knowledge.id == knowledge.id))).scalar_one_or_none()
+            if not current or current.user_id != actor_id:
+                raise HTTPException(403, '知识库已删除或所有者已变更')
+            if (current.meta or {}) != (knowledge.meta or {}):
+                raise HTTPException(409, '知识库配置已更新，请重新读取后恢复')
+            # Keep the current classification/sharing policy; a historic version
+            # is content, never authority to restore old access grants.
+            meta = dict(current.meta or {})
+            meta['nexrag_generation'] = generation
+            meta['nexrag_restore_revisions'] = [
+                *meta.get('nexrag_restore_revisions', []), restored,
+            ]
+            for item in files:
+                db.add(File(**item['record']))
+            await db.flush()
+            await db.execute(delete(KnowledgeFile).where(KnowledgeFile.knowledge_id == knowledge.id))
+            for item in files:
+                db.add(KnowledgeFile(
+                    id=str(uuid.uuid4()), knowledge_id=knowledge.id,
+                    file_id=item['record']['id'], user_id=actor_id,
+                    directory_id=None, created_at=now, updated_at=now,
+                ))
+            current.name = body['name']
+            current.description = body['description']
+            current.updated_at = now
+            current.meta = meta
+    return revision_id
+
+
+async def restore_revision(knowledge, source_revision, actor):
+    # A submitted publication finishes coherently even if its browser disconnects.
+    # Waiting here also keeps the request's writer lock until cleanup/commit ends.
+    task = asyncio.create_task(_restore_revision(knowledge, source_revision, actor))
+    try:
+        return await asyncio.shield(task)
+    except asyncio.CancelledError:
+        try:
+            await task
+        finally:
+            raise
+
+
+async def _restore_revision(knowledge, source_revision, actor):
+    if not enabled():
+        raise HTTPException(409, '版本恢复需要本机知识检索服务')
+    if knowledge.user_id != actor.id:
+        raise HTTPException(403, '只有知识库所有者可以恢复历史版本')
+    selected = next((item for item in revision_history(knowledge)
+                     if item['id'] == source_revision), None)
+    if selected is None:
+        raise HTTPException(404, '版本不存在')
+    body = selected['body']
+    objects = await finished_io(verified_archive_files, body)
+    # Preserve a recoverable copy of the current working state before staging.
+    await record_revision(knowledge.id, actor.id, '恢复前自动保存')
+    generation = 'kb-' + uuid.uuid4().hex
+    staged = []
+    published = False
+    try:
+        for archived, path in objects:
+            identifier = str(uuid.uuid4())
+            filename = Path(archived['filename'].replace('\\', '/')).name
+            stored = await finished_io(copy_archived_file, path, identifier, filename)
+            # Track the file before parsing/indexing so all failure paths can
+            # remove only newly staged resources, never the live version.
+            item = {'record': {'id': identifier, 'path': stored},
+                    'archive': {**archived, 'file_id': identifier}}
+            staged.append(item)
+            text = await finished_io(extract_document, stored, filename)
+            await finished_io(index_document, stored, filename, identifier, generation, actor.id)
+            now = int(time.time())
+            item['record'].update(
+                user_id=actor.id, filename=filename,
+                hash=hashlib.sha256(text.encode('utf8')).hexdigest(),
+                data={'content': text, 'status': 'completed', 'nexrag_edited': False},
+                meta={'name': filename, 'size': archived['size'], 'collection_name': knowledge.id},
+                created_at=now, updated_at=now,
+            )
+        revision_id = await publish_restored_files(
+            knowledge, body, staged, generation, actor.id, source_revision,
+        )
+        published = True
+        return {'id': revision_id, 'restored_from': source_revision}
+    finally:
+        if not published:
+            for item in staged:
+                try:
+                    await finished_io(remove_document, item['record']['id'], generation)
+                    await finished_io(Storage.delete_file, item['record']['path'])
+                except Exception:
+                    # These objects are unreachable from any signed live scope.
+                    # Keep cleanup errors observable without touching live data.
+                    log.exception('Failed to clean an unpublished knowledge generation')
diff --git a/backend/open_webui/utils/nexrag_skill_context.py b/backend/open_webui/utils/nexrag_skill_context.py
new file mode 100644
--- /dev/null
+++ b/backend/open_webui/utils/nexrag_skill_context.py
@@ -0,0 +1,59 @@
+"""Reauthorize skill-derived conversation context before replaying it.
+
+Receipts contain IDs only and live outside the browser-editable chat body.
+Removing a selection cannot erase a receipt: an earlier answer may already
+contain that skill's instructions. Revocation requires a fresh conversation.
+"""
+
+import os
+
+from fastapi import HTTPException
+from open_webui.internal.db import get_async_db_context
+from open_webui.models.chats import Chat
+from open_webui.models.skills import Skills
+from open_webui.utils.chat_id import is_saved_chat_id
+from sqlalchemy import Text, cast, select, update
+
+
+async def guard_skill_context(user, chat_id, selected_ids):
+    if os.environ.get('NEXRAG_WORKSPACE') != 'true':
+        return
+    selected = set(selected_ids)
+    available = {skill.id for skill in await Skills.get_skills(user_id=user.id) if skill.is_active}
+    if selected - available:
+        raise HTTPException(403, '所选技能已停用或撤权，请取消选择后新建对话')
+    if not is_saved_chat_id(chat_id):
+        return
+    # Compare-and-swap preserves concurrent metadata edits without a process-local
+    # lock. Casting JSON to text also works with PostgreSQL's plain JSON type.
+    for _ in range(5):
+        async with get_async_db_context() as db:
+            row = (await db.execute(
+                select(Chat.meta, cast(Chat.meta, Text).label('raw_meta')).where(
+                    Chat.id == chat_id, Chat.user_id == user.id,
+                )
+            )).first()
+            if row is None:
+                if selected:
+                    raise HTTPException(409, '无法记录技能授权，请重新打开对话')
+                return
+            meta, raw_meta = row
+            meta = meta or {}
+            previous = set(meta.get('nexrag_skill_context_ids', []))
+            if previous - available:
+                raise HTTPException(403, '本对话使用过的技能已停用或撤权，请新建对话')
+            combined = sorted(previous | selected)
+            if len(combined) > 256:
+                raise HTTPException(409, '本对话的技能上下文过多，请新建对话')
+            if combined == sorted(previous):
+                return
+            result = await db.execute(
+                update(Chat).where(
+                    Chat.id == chat_id, Chat.user_id == user.id,
+                    cast(Chat.meta, Text).is_(None) if raw_meta is None else cast(Chat.meta, Text) == raw_meta,
+                ).values(meta={**meta, 'nexrag_skill_context_ids': combined})
+            )
+            await db.commit()
+            if result.rowcount == 1:
+                return
+    raise HTTPException(409, '对话授权正在更新，请重试')
diff --git a/backend/open_webui/utils/nexrag_tool_bridge.py b/backend/open_webui/utils/nexrag_tool_bridge.py
new file mode 100644
--- /dev/null
+++ b/backend/open_webui/utils/nexrag_tool_bridge.py
@@ -0,0 +1,66 @@
+"""Short-lived callbacks to the existing, ACL-checked WebUI tool runtime."""
+
+import asyncio
+import hmac
+import os
+import secrets
+import time
+
+import jsonschema
+from fastapi import HTTPException
+from open_webui.models.access_grants import AccessGrants
+from open_webui.models.tools import Tools
+from open_webui.models.users import Users
+
+_tickets = {}
+
+
+def register_tools(user, resolved):
+    from open_webui.utils.nexrag_identity import state
+    now = time.monotonic()
+    for token in list(_tickets):
+        if _tickets[token]['expires'] < now:
+            del _tickets[token]
+    # Only existing server-side local tool callables, already resolved by the
+    # upstream permission checks. Browser/direct-shell tools cannot enter here.
+    selected = {name: value for name, value in (resolved or {}).items()
+                if value.get('tool_id') and value.get('callable') and not value.get('direct')}
+    if not selected:
+        return None, []
+    if len(_tickets) >= 1000:
+        raise HTTPException(503, '工具调用繁忙，请稍后重试')
+    ticket = secrets.token_urlsafe(32)
+    selected = dict(list(selected.items())[:30])
+    _tickets[ticket] = {'user_id': user.id, 'expires': now + 300, 'tools': selected, 'calls': 0,
+                        'session_version': state(user.id)['session_version']}
+    return ticket, [{**entry['spec'], 'name': name, 'tool_id': entry['tool_id']} for name, entry in selected.items()]
+
+
+async def invoke(ticket, name, arguments, user_id, authorization):
+    from open_webui.utils.nexrag_identity import state
+    secret = os.environ.get('NEXRAG_SHARED_API_KEY', '')
+    if not secret or not hmac.compare_digest(authorization, f'Bearer {secret}'):
+        raise HTTPException(401, '工具调用身份无效')
+    session = _tickets.get(ticket)
+    if not session or session['expires'] < time.monotonic() or session['user_id'] != user_id:
+        raise HTTPException(403, '工具调用会话已失效')
+    identity = state(user_id)
+    if identity['must_change_password'] or identity['session_version'] != session['session_version']:
+        raise HTTPException(403, '账号凭据已变更，请重新登录并重新选择工具')
+    entry = session['tools'].get(name)
+    if not entry or session['calls'] >= 20:
+        raise HTTPException(403, '此工具不在本次对话的选择范围内')
+    user = await Users.get_user_by_id(user_id)
+    resource = await Tools.get_tool_by_id(entry['tool_id'])
+    if not user or user.role not in {'user', 'admin'} or not resource or (resource.user_id != user_id and user.role != 'admin'
+        and not await AccessGrants.has_access(user_id, 'tool', resource.id, 'read')):
+        raise HTTPException(403, '工具访问权限已撤回')
+    try:
+        jsonschema.validate(arguments, entry['spec'].get('parameters', {}))
+    except jsonschema.ValidationError as exc:
+        raise HTTPException(422, {'error': exc.message,
+            'parameters': entry['spec'].get('parameters', {})}) from exc
+    if any(key.startswith('__') for key in arguments):
+        raise HTTPException(422, '不能覆盖工具内部身份参数')
+    session['calls'] += 1
+    return await asyncio.wait_for(entry['callable'](**arguments), timeout=45)
diff --git a/backend/open_webui/utils/nexrag_versions.py b/backend/open_webui/utils/nexrag_versions.py
new file mode 100644
--- /dev/null
+++ b/backend/open_webui/utils/nexrag_versions.py
@@ -0,0 +1,128 @@
+"""Deduplicated knowledge snapshots; access always follows the live knowledge ACL."""
+
+import asyncio
+import hashlib
+import json
+import re
+import shutil
+import sqlite3
+import time
+import uuid
+from contextlib import contextmanager
+from pathlib import Path
+
+from open_webui.env import DATA_DIR
+from open_webui.models.knowledge import Knowledges
+from open_webui.storage.provider import Storage
+
+
+class ArchiveIntegrityError(ValueError):
+    """A version is incomplete or damaged and must not be presented as a backup."""
+
+
+def verified_archive_files(body):
+    """Check every archived object before constructing a downloadable ZIP.
+
+    Older snapshots contain content-addressed objects but downloads previously
+    skipped missing objects silently. An incomplete archive must fail visibly.
+    """
+    objects = []
+    for item in body['files']:
+        digest = item.get('blob', '')
+        if not isinstance(digest, str) or not re.fullmatch(r'[a-f0-9]{64}', digest):
+            raise ArchiveIntegrityError('版本文件标识损坏，不能下载不完整的存档')
+        path = root() / 'objects' / digest
+        if not path.is_file() or path.stat().st_size != item.get('size'):
+            raise ArchiveIntegrityError('版本文件缺失或大小不符，请恢复版本备份后重试')
+        with path.open('rb') as stream:
+            actual = hashlib.file_digest(stream, 'sha256').hexdigest()
+        if actual != digest:
+            raise ArchiveIntegrityError('版本文件校验失败，请恢复版本备份后重试')
+        objects.append((item, path))
+    return objects
+
+
+def root():
+    path = Path(DATA_DIR) / 'nexrag-versions'
+    path.mkdir(parents=True, exist_ok=True)
+    return path
+
+
+@contextmanager
+def connection():
+    conn = sqlite3.connect(root() / 'history.db', timeout=30)
+    conn.row_factory = sqlite3.Row
+    conn.execute('CREATE TABLE IF NOT EXISTS revisions (id TEXT PRIMARY KEY, knowledge_id TEXT, created_by TEXT, created_at REAL, note TEXT, signature TEXT, body TEXT)')
+    try:
+        yield conn
+        conn.commit()
+    except Exception:
+        conn.rollback()
+        raise
+    finally:
+        conn.close()
+
+
+def archive_file(file):
+    if (file.data or {}).get('nexrag_edited'):
+        content = (file.data or {}).get('content', '').encode('utf-8')
+        digest = hashlib.sha256(content).hexdigest()
+        blob = root() / 'objects' / digest
+        blob.parent.mkdir(exist_ok=True)
+        if not blob.exists():
+            blob.write_bytes(content)
+        return {'file_id': file.id, 'filename': file.filename + '.txt', 'blob': digest, 'size': len(content)}
+    if not file.path:
+        return None
+    path = Path(Storage.get_file(file.path))
+    if not path.is_file():
+        return None
+    with path.open('rb') as stream:
+        digest = hashlib.file_digest(stream, 'sha256').hexdigest()
+    blob = root() / 'objects' / digest
+    blob.parent.mkdir(exist_ok=True)
+    if not blob.exists():
+        temporary = blob.with_suffix('.' + uuid.uuid4().hex)
+        shutil.copyfile(path, temporary)
+        temporary.replace(blob)
+    return {'file_id': file.id, 'filename': file.filename, 'blob': digest, 'size': path.stat().st_size}
+
+
+async def record_revision(identifier, actor, note='自动记录更新', force=False):
+    knowledge = await Knowledges.get_knowledge_by_id(identifier)
+    if not knowledge or (knowledge.meta or {}).get('source') == 'external':
+        return None
+    files = await Knowledges.get_files_by_id(identifier)
+    documents = []
+    for file in files:
+        item = await asyncio.to_thread(archive_file, file)
+        if not item:
+            raise ArchiveIntegrityError('知识库文件尚无可归档原文，不能发布缺少文件的版本')
+        documents.append(item)
+    body = {'name': knowledge.name, 'description': knowledge.description,
+            'files': sorted(documents, key=lambda item: item['file_id'])}
+    await asyncio.to_thread(verified_archive_files, body)
+    encoded = json.dumps(body, ensure_ascii=False, sort_keys=True)
+    signature = hashlib.sha256(encoded.encode()).hexdigest()
+    with connection() as conn:
+        previous = conn.execute('SELECT id,signature FROM revisions WHERE knowledge_id=? ORDER BY created_at DESC LIMIT 1', (identifier,)).fetchone()
+        if previous and previous['signature'] == signature and not force:
+            return previous['id']
+        revision = uuid.uuid4().hex
+        conn.execute('INSERT INTO revisions VALUES (?,?,?,?,?,?,?)',
+                     (revision, identifier, actor, time.time(), note[:300], signature, encoded))
+        return revision
+
+
+def list_revisions(identifier):
+    with connection() as conn:
+        rows = conn.execute('SELECT id,created_at,note,body FROM revisions WHERE knowledge_id=? ORDER BY created_at DESC', (identifier,)).fetchall()
+    return [{**dict(row), 'body': json.loads(row['body'])} for row in rows]
+
+
+def revision_history(knowledge):
+    # A restored revision is committed with the live file relations in the
+    # same database transaction. No cross-database "commit then audit" gap.
+    restores = (knowledge.meta or {}).get('nexrag_restore_revisions', [])
+    return sorted([*list_revisions(knowledge.id), *restores],
+                  key=lambda row: row['created_at'], reverse=True)
