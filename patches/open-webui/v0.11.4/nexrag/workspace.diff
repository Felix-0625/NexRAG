+"""Local speech recognition without torch, external audio upload, or system FFmpeg."""
+
+import importlib
+import logging
+import os
+import threading
+from pathlib import Path
+
+from fastapi import HTTPException
+
+log = logging.getLogger(__name__)
+_model_lock = threading.RLock()
+_model_key = None
+_model = None
+
+
+def require_local_stt(*, slim: bool):
+    """Only NexRAG's explicit native opt-in enables local speech in slim builds."""
+    if slim and os.getenv('NEXRAG_LOCAL_STT', 'false').lower() not in ('true', '1', 'yes'):
+        raise HTTPException(
+            503, '本地语音识别未启用，请启用 NEXRAG_LOCAL_STT=true 后重启。音频不会自动发送到外部服务。'
+        )
+    try:
+        return importlib.import_module('faster_whisper').WhisperModel
+    except (ImportError, OSError) as exc:
+        log.warning('Local speech dependencies unavailable: %s', exc)
+        raise HTTPException(
+            503, '本地语音识别依赖未就绪，请重新运行本地启动命令安装依赖后重试。音频未发送到外部服务。'
+        ) from exc
+
+
+def load_local_whisper(
+    model: str, *, slim: bool, auto_update: bool, device: str, compute_type: str, download_root: str
+):
+    """Keep one shared model; concurrent first requests cannot duplicate loading."""
+    model_class = require_local_stt(slim=slim)
+    if not model:
+        raise HTTPException(503, '请在管理员语音设置中选择本地 Whisper 模型。')
+    kwargs = dict(
+        device='cpu' if slim else device,
+        compute_type='int8' if slim else compute_type,
+        download_root=download_root,
+        local_files_only=True,
+    )
+    # auto_update controls the first probe; a model already loaded needs no reload.
+    key = (model, kwargs['device'], kwargs['compute_type'], str(download_root))
+    global _model_key, _model
+    with _model_lock:
+        if _model_key == key and _model is not None:
+            return _model
+        try:
+            model_path = Path(model)
+            if model_path.is_absolute():
+                if not (model_path / 'model.bin').is_file():
+                    raise ValueError('Custom model directory must contain model.bin')
+            else:
+                # Resolve catalog names through the official downloader: the checkout
+                # contains base/, which must never shadow the Whisper model named base.
+                download = importlib.import_module('faster_whisper.utils').download_model
+                try:
+                    resolved = download(model, cache_dir=download_root, local_files_only=not auto_update)
+                except Exception:
+                    if auto_update:
+                        raise
+                    # Only public weights are downloaded; no audio or transcript leaves the device.
+                    log.info('Local Whisper weights missing; downloading selected model %s', model)
+                    resolved = download(model, cache_dir=download_root, local_files_only=False)
+                model_path = Path(resolved).resolve()
+            loaded = model_class(model_size_or_path=str(model_path), **kwargs)
+        except Exception as exc:
+            log.exception('Local Whisper model initialization failed')
+            raise HTTPException(
+                503,
+                '本地语音模型加载失败。首次使用需下载模型，请检查网络或配置已下载的模型目录后重试；音频未发送到外部服务。',
+            ) from exc
+        _model_key, _model = key, loaded
+        return loaded
+
+
+def transcribe_local_whisper(model, file_path: str, **options) -> str:
+    """Serialize CPU inference and consume the generator while holding the lock."""
+    with _model_lock:
+        try:
+            segments, _info = model.transcribe(file_path, **options)
+            return ''.join(segment.text for segment in segments)
+        except Exception as exc:
+            log.exception('Local Whisper transcription failed')
+            raise HTTPException(400, '本地语音识别失败，请检查录音格式及内容后重试；音频未发送到外部服务。') from exc
