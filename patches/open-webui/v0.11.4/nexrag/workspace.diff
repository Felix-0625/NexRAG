diff --git a/src/lib/utils/browser-voices.ts b/src/lib/utils/browser-voices.ts
new file mode 100644
--- /dev/null
+++ b/src/lib/utils/browser-voices.ts
@@ -0,0 +1,29 @@
+/** Wait for native voice discovery without polling or surviving cancellation. */
+export const waitForBrowserVoices = (
+	signal: AbortSignal,
+	timeoutMs = 5000
+): Promise<SpeechSynthesisVoice[]> => {
+	if (signal.aborted || typeof window === 'undefined' || !('speechSynthesis' in window)) {
+		return Promise.resolve([]);
+	}
+	const synthesis = window.speechSynthesis;
+	const available = synthesis.getVoices();
+	if (available.length) return Promise.resolve(available);
+	return new Promise((resolve) => {
+		const finish = (voices: SpeechSynthesisVoice[]) => {
+			clearTimeout(timeout);
+			synthesis.removeEventListener('voiceschanged', changed);
+			signal.removeEventListener('abort', aborted);
+			resolve(voices);
+		};
+		const changed = () => {
+			const voices = synthesis.getVoices();
+			if (voices.length) finish(voices);
+		};
+		const aborted = () => finish([]);
+		const timeout = setTimeout(() => finish([]), timeoutMs);
+		synthesis.addEventListener('voiceschanged', changed);
+		signal.addEventListener('abort', aborted, { once: true });
+		changed();
+	});
+};
