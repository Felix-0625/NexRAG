+                    raise HTTPException(status_code=502, detail='NexRAG tenant service rejected the request')
+                return await response.json()
+    except aiohttp.ClientError as exc:
+        raise HTTPException(status_code=502, detail='NexRAG tenant service is unavailable') from exc
