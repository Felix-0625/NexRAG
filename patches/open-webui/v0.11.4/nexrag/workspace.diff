+	import { request, workspaceRequest } from '$lib/apis/nexrag';
+	import { getModels } from '$lib/apis';
+	import { config, models, user, workspaceCounts } from '$lib/stores';
+
+	const providers = [
+		{ id: 'ollama', label: 'Ollama / 本地', url: 'http://127.0.0.1:11434/v1', protocol: 'openai' },
+		{ id: 'deepseek', label: 'DeepSeek', url: 'https://api.deepseek.com/v1', protocol: 'openai' },
+		{ id: 'openai', label: 'OpenAI', url: 'https://api.openai.com/v1', protocol: 'responses' },
+		{ id: 'anthropic', label: 'Anthropic / Claude', url: 'https://api.anthropic.com', protocol: 'anthropic' },
+		{ id: 'google', label: 'Google / Gemini', url: 'https://generativelanguage.googleapis.com', protocol: 'google' },
+		{ id: 'custom', label: '自定义接口', url: '', protocol: 'openai' }
+	];
+	const blank = () => ({name: '', provider: 'ollama', protocol: 'openai', model_name: '', base_url: providers[0].url, api_key: '', clear_api_key: false, enabled: true, audience: 'all', allowed_user_ids: [] as string[]});
