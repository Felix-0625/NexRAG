+<script lang="ts">
+	import { user } from '$lib/stores';
+	import { rememberAccount } from '$lib/utils/accountSwitcher';
+	let password = '';
+	let nextPassword = '';
+	let confirmation = '';
+	let error = '';
+	let busy = false;
+	async function submit() {
+		error = '';
+		if (nextPassword !== confirmation) {
+			error = '两次新密码不一致';
+			return;
+		}
+		busy = true;
+		try {
+			const response = await fetch('/api/v1/auths/nexrag/change-password', {
+				method: 'POST',
+				headers: {
+					'Content-Type': 'application/json',
+					Authorization: `Bearer ${localStorage.token}`
+				},
+				body: JSON.stringify({ password, new_password: nextPassword })
+			});
+			const result = await response.json();
+			if (!response.ok)
+				throw new Error(typeof result.detail === 'string' ? result.detail : '密码修改失败');
+			localStorage.token = result.token;
+			user.set(result);
+			rememberAccount({ ...result, profileImageUrl: result.profile_image_url });
+			password = '';
+			nextPassword = '';
+			confirmation = '';
+			window.location.assign('/');
+		} catch (cause) {
+			error = cause instanceof Error ? cause.message : String(cause);
+		} finally {
+			busy = false;
+		}
+	}
+</script>
+
+<div
+	class="fixed inset-0 z-[9999] grid place-items-center bg-gray-950/80 p-6"
+	role="dialog"
+	aria-modal="true"
+	aria-labelledby="password-title"
+>
+	<form
+		class="w-full max-w-md rounded-2xl bg-white p-7 text-gray-900 shadow-xl dark:bg-gray-900 dark:text-white space-y-5"
+		on:submit|preventDefault={submit}
+	>
+		<div>
+			<h1 id="password-title" class="text-xl font-semibold">设置你自己的登录密码</h1>
+			<p class="mt-3 text-sm text-gray-500">
+				这是管理员分发或重置的临时凭据。完成修改后才能访问业务数据和知识库，旧登录会话将失效。
+			</p>
+		</div>
+		<label class="block text-sm"
+			>临时密码或当前密码<input
+				class="mt-2 block w-full rounded-lg border border-gray-300 bg-transparent p-3 dark:border-gray-700"
+				type="password"
+				autocomplete="current-password"
+				bind:value={password}
+				required
+			/></label
+		>
+		<label class="block text-sm"
+			>新密码（至少 15 个字符，可使用长口令）<input
+				class="mt-2 block w-full rounded-lg border border-gray-300 bg-transparent p-3 dark:border-gray-700"
+				type="password"
+				autocomplete="new-password"
+				bind:value={nextPassword}
+				minlength="15"
+				required
+			/></label
+		>
+		<label class="block text-sm"
+			>再次输入新密码<input
+				class="mt-2 block w-full rounded-lg border border-gray-300 bg-transparent p-3 dark:border-gray-700"
+				type="password"
+				autocomplete="new-password"
+				bind:value={confirmation}
+				minlength="15"
+				required
+			/></label
+		>
+		{#if error}<p role="alert" class="text-sm text-red-600">{error}</p>{/if}
+		<button class="w-full rounded-lg bg-blue-600 p-3 text-white disabled:opacity-50" disabled={busy}
+			>{busy ? '正在更新…' : '修改密码并继续'}</button
+		>
+	</form>
+</div>
