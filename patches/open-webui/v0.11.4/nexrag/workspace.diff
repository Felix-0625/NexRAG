+"""Resolve only server-owned knowledge generations after the live ACL lookup."""
+
+import re
+
+from open_webui.models.knowledge import Knowledges
+
+
+def collection_for(knowledge):
+    generation = (knowledge.meta or {}).get('nexrag_generation')
+    if generation is None:
+        return knowledge.id
+    if not isinstance(generation, str) or not re.fullmatch(r'kb-[a-f0-9]{32}', generation):
+        raise ValueError('知识库索引版本无效，请联系维护者')
+    return generation
+
+
+async def library_target(identifier):
+    knowledge = await Knowledges.get_knowledge_by_id(identifier)
+    return collection_for(knowledge) if knowledge else identifier
diff --git a/backend/open_webui/utils/nexrag_identity.py b/backend/open_webui/utils/nexrag_identity.py
new file mode 100644
--- /dev/null
+++ b/backend/open_webui/utils/nexrag_identity.py
@@ -0,0 +1,133 @@
+"""Native account lifecycle state without an external session service.
+
+The store contains no passwords or bearer tokens. A monotonically increasing
+generation invalidates remembered sessions on credential/role changes. Existing
+accounts remain generation zero until an explicit lifecycle action occurs.
+"""
+
+import os
+import sqlite3
+import time
+import uuid
+from contextlib import contextmanager
+from pathlib import Path
+
+
+def native_identity():
+    return os.environ.get('NEXRAG_WORKSPACE') == 'true'
+
+
+@contextmanager
+def _store():
+    directory = Path(os.environ.get('DATA_DIR', './data')).resolve()
+    directory.mkdir(parents=True, exist_ok=True)
+    connection = sqlite3.connect(directory / 'nexrag-identity.sqlite3', timeout=10)
+    connection.row_factory = sqlite3.Row
+    try:
+        connection.execute('CREATE TABLE IF NOT EXISTS accounts ('
+                           'user_id TEXT PRIMARY KEY, session_version INTEGER NOT NULL DEFAULT 0, '
+                           'must_change_password INTEGER NOT NULL DEFAULT 0)')
+        connection.execute('CREATE TABLE IF NOT EXISTS revoked_tokens ('
+                           'jti TEXT PRIMARY KEY, expires_at REAL)')
+        connection.execute('CREATE TABLE IF NOT EXISTS security_events ('
+                           'id TEXT PRIMARY KEY, actor_id TEXT NOT NULL, target_id TEXT NOT NULL, '
+                           'action TEXT NOT NULL, created_at REAL NOT NULL)')
+        yield connection
+        connection.commit()
+    finally:
+        connection.close()
+
+
+def state(user_id):
+    with _store() as connection:
+        row = connection.execute('SELECT session_version,must_change_password FROM accounts WHERE user_id=?',
+                                 (str(user_id),)).fetchone()
+    return {'session_version': row[0] if row else 0,
+            'must_change_password': bool(row and row[1])}
+
+
+def provision(user_id):
+    """Administrator-distributed credentials cannot be used for business work."""
+    with _store() as connection:
+        connection.execute('INSERT INTO accounts VALUES (?,0,1) ON CONFLICT(user_id) '
+                           'DO UPDATE SET session_version=session_version+1,must_change_password=1',
+                           (str(user_id),))
+
+
+def revoke_all(user_id):
+    with _store() as connection:
+        connection.execute('INSERT INTO accounts VALUES (?,1,0) ON CONFLICT(user_id) '
+                           'DO UPDATE SET session_version=session_version+1', (str(user_id),))
+        return connection.execute('SELECT session_version FROM accounts WHERE user_id=?', (str(user_id),)).fetchone()[0]
+
+
+def password_changed(user_id, expected_version):
+    with _store() as connection:
+        # A later administrator reset must not be undone by a slower password
+        # change request finishing on another worker/browser.
+        changed = connection.execute('UPDATE accounts SET must_change_password=0 WHERE user_id=? AND session_version=?',
+                                     (str(user_id), expected_version))
+        return bool(changed.rowcount)
+
+
+def accepts(claims):
+    user_id = claims.get('id')
+    if not isinstance(user_id, str) or not user_id:
+        return False
+    # Legacy JWTs are valid only until the account's first revocation action.
+    version = claims.get('nsv', 0)
+    if type(version) is not int or version != state(user_id)['session_version']:
+        return False
+    with _store() as connection:
+        connection.execute('DELETE FROM revoked_tokens WHERE expires_at IS NOT NULL AND expires_at < ?',
+                           (time.time(),))
+        revoked = connection.execute('SELECT 1 FROM revoked_tokens WHERE jti=?', (claims.get('jti', ''),)).fetchone()
+    return not revoked
+
+
+def revoke_token(claims):
+    if not claims.get('jti'):
+        revoke_all(claims.get('id', ''))
+        return
+    with _store() as connection:
+        connection.execute('INSERT OR REPLACE INTO revoked_tokens VALUES (?,?)',
+                           (claims['jti'], claims.get('exp')))
+
+
+def password_change_allowed(path, method):
+    """Only session inspection, logout, and password change survive this gate."""
+    return (method == 'GET' and path in {'/api/v1/auths/', '/api/v1/auths/nexrag/identity'}) or (
+        method == 'POST' and path in {'/api/v1/auths/signout', '/api/v1/auths/nexrag/change-password',
+                                     '/api/v1/auths/update/password'})
+
+
+def validate_new_password(password):
+    # NIST SP 800-63B-4 single-factor minimum; no brittle character-class rules.
+    if len(password) < 15:
+        raise ValueError('新密码至少需要 15 个字符，可以使用易记的长口令')
+    common = {'123456789012345', 'passwordpassword', 'password123456789',
+              'administrator123', 'changeme123456789', 'qwertyuiopasdfgh'}
+    if password.casefold().strip() in common or len(set(password)) == 1:
+        raise ValueError('请勿使用常见口令或重复字符，请设置个人独有的长口令')
+
+
+def record_event(actor_id, target_id, action):
+    """Persist security metadata independently of optional event subscribers."""
+    allowed = {'account.provisioned', 'account.bootstrap', 'account.role_changed',
+               'password.reset', 'password.changed', 'session.signed_in', 'session.signed_out'}
+    if action not in allowed:
+        raise ValueError('Unknown security event')
+    if not all(isinstance(value, str) and 0 < len(value) <= 128 for value in (actor_id, target_id)):
+        raise ValueError('Invalid security identity')
+    with _store() as connection:
+        connection.execute('INSERT INTO security_events VALUES (?,?,?,?,?)',
+                           (uuid.uuid4().hex, actor_id, target_id, action, time.time()))
+
+
+def security_events(limit=100, target_id=None):
+    limit = max(1, min(int(limit), 200))
+    clause, values = (' WHERE target_id=?', (target_id,)) if target_id else ('', ())
+    with _store() as connection:
+        rows = connection.execute('SELECT * FROM security_events' + clause +
+                                  ' ORDER BY created_at DESC LIMIT ?', (*values, limit)).fetchall()
+    return [dict(row) for row in rows]
