+@app.get('/api/nexrag/tenants')
+async def get_nexrag_tenants(request: Request, user=Depends(get_verified_user)):
+    """Proxy tenant choices using the verified Open WebUI user identity."""
+    base_url = os.environ.get('NEXRAG_API_BASE_URL', '').rstrip('/')
+    service_key = os.environ.get('NEXRAG_SHARED_API_KEY', '')
+    jwt_secret = os.environ.get('FORWARD_USER_INFO_HEADER_JWT_SECRET', '')
+    if not base_url or len(service_key) < 32 or len(jwt_secret) < 32:
+        raise HTTPException(status_code=503, detail='NexRAG tenant service is not configured')
+
+    headers = include_user_info_headers(
+        {'Authorization': f'Bearer {service_key}'}, user, request=request
+    )
+    try:
+        async with aiohttp.ClientSession(timeout=aiohttp.ClientTimeout(total=10)) as session:
+            async with session.get(f'{base_url}/tenants', headers=headers) as response:
+                if response.status != 200:
+                    raise HTTPException(status_code=502, detail='NexRAG tenant service rejected the request')
+                return await response.json()
+    except aiohttp.ClientError as exc:
+        raise HTTPException(status_code=502, detail='NexRAG tenant service is unavailable') from exc
+
