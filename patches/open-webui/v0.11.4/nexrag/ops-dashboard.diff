@@ -0,0 +1,42 @@
+// PATCH NEXRAG OPS DASHBOARD
+// Password-free account switching for multi-tenant demos: remembers every
+// account this browser has signed into (token + display info) so the user
+// can hop between them without re-entering a password. Purely client-side —
+// nothing is sent to or trusted from the server beyond the token it issued.
+const STORAGE_KEY = 'nexrag.rememberedAccounts';
+
+export type RememberedAccount = {
+	id: string;
+	token: string;
+	name: string;
+	email: string;
+	role: string;
+	profileImageUrl?: string;
+};
+
+export const listRememberedAccounts = (): RememberedAccount[] => {
+	try {
+		const raw = localStorage.getItem(STORAGE_KEY);
+		return raw ? JSON.parse(raw) : [];
+	} catch {
+		return [];
+	}
+};
+
+export const rememberAccount = (account: RememberedAccount) => {
+	const accounts = listRememberedAccounts().filter((a) => a.id !== account.id);
+	accounts.unshift(account);
+	// Cap the list; this is a demo convenience, not a credential vault.
+	localStorage.setItem(STORAGE_KEY, JSON.stringify(accounts.slice(0, 10)));
+};
+
+export const forgetAccount = (id: string) => {
+	localStorage.setItem(
+		STORAGE_KEY,
+		JSON.stringify(listRememberedAccounts().filter((a) => a.id !== id))
+	);
+};
+
+export const otherRememberedAccounts = (currentUserId: string | undefined) =>
+	listRememberedAccounts().filter((a) => a.id !== currentUserId);
+// /PATCH NEXRAG OPS DASHBOARD
