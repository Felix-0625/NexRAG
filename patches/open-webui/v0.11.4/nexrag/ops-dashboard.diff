+<script lang="ts">
+	// PATCH NEXRAG OPS DASHBOARD
+	import { getContext, onMount } from 'svelte';
+	import type { Writable } from 'svelte/store';
+	import type { i18n as i18nType } from 'i18next';
+	import { toast } from 'svelte-sonner';
+	import Spinner from '$lib/components/common/Spinner.svelte';
+	import {
+		deleteKnowledgeDocument,
+		getKnowledgeDocuments,
+		getOpsOverview,
+		getProposal,
+		getProposals,
+		getTrace,
+		getTraces,
+		reviewProposal,
+		runEvolution,
+		uploadKnowledgeDocument
+	} from '$lib/apis/nexrag';
+
+	const i18n = getContext<Writable<i18nType>>('i18n');
+
+	let view: string = 'overview';
+	// PATCH NEXRAG OPS DASHBOARD: admin-maintained shared knowledge base.
+	let knowledgeDocs: any[] = [];
+	let uploading = false;
+	let fileInput: HTMLInputElement;
+
+	const loadKnowledge = async () => {
+		knowledgeDocs = (await getKnowledgeDocuments(localStorage.token).catch((e) => (toast.error(`${e}`), null)))
+			?.data ?? [];
+	};
+
+	const uploadKnowledge = async (files: FileList | null) => {
+		if (!files?.length) return;
+		uploading = true;
+		for (const file of files) {
+			await uploadKnowledgeDocument(localStorage.token, file).catch((error) => toast.error(`${error}`));
+		}
+		uploading = false;
+		if (fileInput) fileInput.value = '';
+		await loadKnowledge();
+	};
+
+	const deleteKnowledge = async (fileId: string) => {
+		if (!window.confirm($i18n.t('Remove this file from the shared knowledge base?'))) return;
+		await deleteKnowledgeDocument(localStorage.token, fileId).catch((error) => toast.error(`${error}`));
+		await loadKnowledge();
+	};
+	// /PATCH NEXRAG OPS DASHBOARD
+	let loading = true;
+	let overview: any = null;
+	let traces: any[] = [];
+	let traceDetail: any = null;
+	let proposals: any[] = [];
+	let backlog: any = null;
+	let proposalDetail: any = null;
+	let reviewNote = '';
+	let running = false;
+
+	const fmtTime = (t: number) => (t ? new Date(t * 1000).toLocaleString() : '-');
+	const pct = (v: number | null | undefined) => (v == null ? '-' : `${(v * 100).toFixed(1)}%`);
+	const num = (v: any, d = 3) => (v == null ? '-' : Number(v).toFixed(d));
+
+	const load = async () => {
+		loading = true;
+		try {
+			if (view === 'overview') overview = await getOpsOverview(localStorage.token, 7);
+			if (view === 'traces') traces = await getTraces(localStorage.token);
+			if (view === 'proposals') {
+				const res = await getProposals(localStorage.token);
+				proposals = res.proposals;
+				backlog = res.backlog;
+			}
+			if (view === 'knowledge') await loadKnowledge(); // PATCH NEXRAG OPS DASHBOARD
+		} catch (error) {
+			toast.error(`${error}`);
+		}
+		loading = false;
+	};
+
+	const openTrace = async (id: string) => {
+		traceDetail = await getTrace(localStorage.token, id).catch((e) => (toast.error(`${e}`), null));
+	};
+
+	const openProposal = async (id: string) => {
+		reviewNote = '';
+		proposalDetail = await getProposal(localStorage.token, id).catch((e) => (toast.error(`${e}`), null));
+	};
+
+	const act = async (action: 'approve' | 'reject' | 'promote' | 'rollback') => {
+		if (!proposalDetail) return;
+		try {
+			await reviewProposal(localStorage.token, proposalDetail.id, action, reviewNote);
+			toast.success(`${action}: ok`);
+			await openProposal(proposalDetail.id);
+			await load();
+		} catch (error) {
+			toast.error(`${error}`);
+		}
+	};
+
+	const triggerCycle = async () => {
+		running = true;
+		try {
+			const report = await runEvolution(localStorage.token);
+			const actions = (report.actions ?? []).map((a: any) => `${a.kind ?? ''} ${a.action}`).join(', ');
+			toast.success(actions || 'cycle finished');
+			view = 'proposals';
+			await load();
+		} catch (error) {
+			toast.error(`${error}`);
+		}
+		running = false;
+	};
+
+	const scoreOf = (name: string, source = 'rule') =>
+		overview?.scores?.find((s: any) => s.name === name && s.source === source)?.mean;
+
+	onMount(load);
+</script>
+
+<div class="flex flex-col gap-3 py-2 text-sm">
+	<div class="flex items-center justify-between gap-2">
+		<div class="flex gap-1" role="tablist" aria-label="NexRAG operations">
+			{#each [['overview', 'Overview'], ['traces', 'Traces'], ['proposals', 'Proposals'], ['knowledge', 'Knowledge base']] as [id, label]}
+				<button
+					type="button"
+					role="tab"
+					aria-selected={view === id}
+					class="px-2.5 py-1 rounded-lg transition {view === id
+						? 'bg-gray-100 dark:bg-gray-850 font-medium'
+						: 'text-gray-500 hover:text-gray-900 dark:hover:text-white'}"
+					on:click={() => {
+						view = id;
+						traceDetail = null;
+						proposalDetail = null;
+						load();
+					}}>{$i18n.t(label)}</button
+				>
+			{/each}
+		</div>
+		<button
+			type="button"
+			class="px-3 py-1 rounded-full bg-black text-white dark:bg-white dark:text-black text-xs disabled:opacity-50"
+			disabled={running}
+			on:click={triggerCycle}
+		>
+			{running ? $i18n.t('Running…') : $i18n.t('Run evolution cycle')}
+		</button>
+	</div>
+
+	{#if loading}
+		<div class="flex justify-center py-10"><Spinner className="size-5" /></div>
+	{:else if view === 'overview' && overview}
+		{#if overview.backlog?.alert || overview.backlog?.queue_full}
+			<div
+				role="alert"
+				class="rounded-lg border border-amber-300 bg-amber-50 px-3 py-2 text-xs text-amber-800 dark:border-amber-700 dark:bg-amber-950 dark:text-amber-200"
+			>
+				{$i18n.t('Proposal backlog needs review')}: {overview.backlog.counts?.pending_review ?? 0} pending,
+				oldest {overview.backlog.oldest_pending_days} days{overview.backlog.queue_full
+					? ' — queue is full, new proposals are paused'
+					: ''}.
+			</div>
+		{/if}
+		<div class="grid grid-cols-2 lg:grid-cols-5 gap-2">
+			{#each [['Traces (7d)', overview.totals?.traces ?? 0], ['Success', pct((overview.totals?.ok ?? 0) / Math.max(overview.totals?.traces ?? 0, 1))], ['Avg latency', `${Math.round(overview.totals?.avg_latency ?? 0)} ms`], ['Reflection rate', num(scoreOf('reflections'), 2)], ['Thumbs up', pct(scoreOf('user_rating', 'user'))]] as [label, value]}
+				<div class="rounded-xl border border-gray-100 dark:border-gray-850 p-3">
+					<div class="text-xs text-gray-500">{$i18n.t(label)}</div>
+					<div class="text-lg font-medium">{value}</div>
+				</div>
+			{/each}
+		</div>
+		<table class="w-full text-xs">
+			<caption class="text-left text-gray-500 pb-1">{$i18n.t('Daily trend')}</caption>
+			<thead class="text-gray-500"><tr><th class="text-left font-normal">Day</th><th class="text-right font-normal">Traces</th><th class="text-right font-normal">Success</th><th class="text-right font-normal">Latency</th></tr></thead>
+			<tbody>
+				{#each overview.daily as row}
