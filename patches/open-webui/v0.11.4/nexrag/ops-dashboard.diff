+<script lang="ts">
+	// PATCH NEXRAG OPS DASHBOARD
+	// Business tenant catalogue. Per-user grants are edited from each
+	// account's Edit User modal (NexRAGMemory lives in Settings > Personalization);
+	// this page only manages which tenants exist.
+	import { getContext, onMount } from 'svelte';
+	import type { Writable } from 'svelte/store';
+	import type { i18n as i18nType } from 'i18next';
+	import { toast } from 'svelte-sonner';
+	import Spinner from '$lib/components/common/Spinner.svelte';
+	import { createTenant, deleteTenant, getTenants } from '$lib/apis/nexrag';
+
+	const i18n = getContext<Writable<i18nType>>('i18n');
+
+	let tenants: Record<string, string> | null = null;
+	let grants: Record<string, string[]> = {};
+	let newId = '';
+	let newLabel = '';
+	let busy = false;
+
+	const load = async () => {
+		const res = await getTenants(localStorage.token).catch((error) => {
+			toast.error(`${error}`);
+			return null;
+		});
+		if (res) {
+			tenants = res.tenants;
+			grants = res.grants;
+		}
+	};
+
+	const grantCount = (tenantId: string) =>
+		Object.values(grants).filter((ids) => ids.includes(tenantId)).length;
+
+	const add = async () => {
+		if (!newId.trim() || !newLabel.trim()) return;
+		busy = true;
+		await createTenant(localStorage.token, newId.trim(), newLabel.trim()).catch((error) => {
+			toast.error(`${error}`);
+		});
+		newId = '';
+		newLabel = '';
+		busy = false;
+		await load();
+	};
+
+	const remove = async (tenantId: string) => {
+		if (!window.confirm($i18n.t('Delete this tenant and every grant for it?'))) return;
+		busy = true;
+		await deleteTenant(localStorage.token, tenantId).catch((error) => {
+			toast.error(`${error}`);
+		});
+		busy = false;
+		await load();
+	};
+
+	onMount(load);
+</script>
+
+<div class="flex flex-col gap-3 py-2 text-sm">
+	<div class="text-xs text-gray-500">
+		{$i18n.t(
+			'Grant or revoke which tenant each account can view from that account’s Edit User dialog on the Overview tab.'
+		)}
+	</div>
+
+	<div class="flex items-end gap-2">
+		<label class="flex flex-col text-xs text-gray-500 flex-1">
+			{$i18n.t('Tenant ID')}
+			<input
+				class="rounded-lg border border-gray-200 dark:border-gray-800 bg-transparent px-2 py-1 text-sm"
+				bind:value={newId}
+				placeholder="seller-a"
+			/>
+		</label>
+		<label class="flex flex-col text-xs text-gray-500 flex-1">
+			{$i18n.t('Label')}
+			<input
+				class="rounded-lg border border-gray-200 dark:border-gray-800 bg-transparent px-2 py-1 text-sm"
+				bind:value={newLabel}
+				placeholder="Seller A"
+			/>
+		</label>
+		<button
+			type="button"
+			class="px-3 py-1.5 rounded-full bg-black text-white dark:bg-white dark:text-black text-xs disabled:opacity-50"
+			disabled={busy}
+			on:click={add}>{$i18n.t('Add tenant')}</button
+		>
+	</div>
+
+	{#if tenants === null}
+		<div class="flex justify-center py-6"><Spinner className="size-5" /></div>
+	{:else if Object.keys(tenants).length === 0}
+		<div class="text-xs text-gray-400 py-4">{$i18n.t('No tenants configured yet.')}</div>
+	{:else}
+		<table class="w-full text-xs">
+			<thead class="text-gray-500">
+				<tr>
+					<th class="text-left font-normal">ID</th>
+					<th class="text-left font-normal">{$i18n.t('Label')}</th>
+					<th class="text-right font-normal">{$i18n.t('Accounts granted')}</th>
+					<th></th>
+				</tr>
+			</thead>
+			<tbody>
+				{#each Object.entries(tenants) as [tenantId, label]}
+					<tr class="border-t border-gray-100 dark:border-gray-850">
+						<td><code>{tenantId}</code></td>
+						<td>{label}</td>
+						<td class="text-right">{grantCount(tenantId)}</td>
+						<td class="text-right">
+							<button
+								type="button"
+								class="text-gray-500 hover:text-red-600 hover:underline"
+								disabled={busy}
+								on:click={() => remove(tenantId)}>{$i18n.t('Delete')}</button
+							>
+						</td>
+					</tr>
+				{/each}
+			</tbody>
+		</table>
+	{/if}
+</div>
+<!-- /PATCH NEXRAG OPS DASHBOARD -->
