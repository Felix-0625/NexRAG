+<script lang="ts">
+	// PATCH NEXRAG OPS DASHBOARD
+	// Personal NexRAG long-term memory: only the signed-in user's own records.
+	import { getContext, onMount } from 'svelte';
+	import type { Writable } from 'svelte/store';
+	import type { i18n as i18nType } from 'i18next';
+	import { toast } from 'svelte-sonner';
+	import Spinner from '$lib/components/common/Spinner.svelte';
+	import {
+		confirmNexragMemory,
+		forgetAllNexragMemories,
+		forgetNexragMemory,
+		getNexragMemories
+	} from '$lib/apis/nexrag';
+
+	const i18n = getContext<Writable<i18nType>>('i18n');
+
+	let items: any[] = [];
+	let loading = true;
+	let unavailable = '';
+	let showHistory = false;
+
+	const load = async () => {
+		loading = true;
+		try {
+			items = (await getNexragMemories(localStorage.token, showHistory)).data ?? [];
+			unavailable = '';
+		} catch (error) {
+			unavailable = `${error}`;
+			items = [];
+		}
+		loading = false;
+	};
+
+	const confirm = async (id: string) => {
+		try {
+			await confirmNexragMemory(localStorage.token, id);
+			toast.success($i18n.t('Memory confirmed'));
+			await load();
+		} catch (error) {
+			toast.error(`${error}`);
+		}
+	};
+
+	const forget = async (id?: string) => {
+		const message = id
+			? $i18n.t('Forget this memory and its earlier versions?')
+			: $i18n.t('Forget all NexRAG memories? This cannot be undone.');
+		if (!window.confirm(message)) return;
+		try {
+			id ? await forgetNexragMemory(localStorage.token, id) : await forgetAllNexragMemories(localStorage.token);
+			await load();
+		} catch (error) {
+			toast.error(`${error}`);
+		}
+	};
+
+	const scopeLabel = (m: any) =>
+		m.scope === 'global' ? $i18n.t('All tenants') : m.scope === 'tenant' ? `${$i18n.t('Tenant')} ${m.tenant_id?.slice(0, 8)}…` : $i18n.t('This chat');
+
+	onMount(load);
+</script>
+
+<div class="flex flex-col gap-2 text-xs" aria-live="polite">
+	<div class="flex items-center justify-between">
+		<div class="text-sm font-medium">{$i18n.t('NexRAG long-term memory')}</div>
+		<div class="flex items-center gap-3">
+			<label class="flex items-center gap-1 text-gray-500">
+				<input type="checkbox" bind:checked={showHistory} on:change={load} />
+				{$i18n.t('Show history')}
+			</label>
+			<button type="button" class="text-gray-500 hover:text-red-600 hover:underline disabled:opacity-40" disabled={!items.length} on:click={() => forget()}>
+				{$i18n.t('Forget all')}
+			</button>
+		</div>
+	</div>
+	<div class="text-gray-500">
+		{$i18n.t('Only you can see these. Disputed items were contradicted later; confirm the one that is correct.')}
+	</div>
+	{#if loading}
+		<Spinner className="size-4" />
+	{:else if unavailable}
+		<div class="text-gray-400">{unavailable}</div>
+	{:else if !items.length}
+		<div class="text-gray-400">{$i18n.t('NexRAG has not remembered anything about you yet.')}</div>
+	{:else}
+		<ul class="flex flex-col gap-1.5">
+			{#each items as m (m.id)}
+				<li class="flex items-start justify-between gap-3 {m.status === 'superseded' || m.status === 'archived' ? 'opacity-50' : ''}">
+					<div class="min-w-0">
+						<div class="break-words">
+							<span class="text-gray-500">{m.subject} / {m.attribute}:</span> {m.value}
+						</div>
+						<div class="text-[0.6875rem] text-gray-400">
+							{scopeLabel(m)} · {m.source} · {new Date(m.valid_from * 1000).toLocaleDateString()}
+							{#if m.status !== 'active'} · <span class={m.status === 'disputed' ? 'text-amber-600 dark:text-amber-400' : ''}>{m.status}</span>{/if}
+						</div>
+					</div>
+					<div class="flex shrink-0 gap-2">
+						{#if m.status === 'disputed'}
+							<button type="button" class="text-amber-700 dark:text-amber-300 hover:underline" on:click={() => confirm(m.id)}>{$i18n.t('This is correct')}</button>
+						{/if}
+						<button type="button" class="text-gray-500 hover:underline" on:click={() => forget(m.id)}>{$i18n.t('Forget')}</button>
+					</div>
+				</li>
+			{/each}
+		</ul>
+	{/if}
+</div>
+<!-- /PATCH NEXRAG OPS DASHBOARD -->
