@@ -0,0 +1,75 @@
+import { WEBUI_BASE_URL } from '$lib/constants';
+
+// PATCH NEXRAG OPS DASHBOARD
+// Calls go to the Open WebUI backend proxy (/api/nexrag/*), which forwards the
+// verified identity to NexRAG. The browser never holds NexRAG credentials.
+const request = async (token: string, path: string, method = 'GET', body?: object) => {
+	const res = await fetch(`${WEBUI_BASE_URL}/api/nexrag/${path}`, {
+		method,
+		headers: {
+			Accept: 'application/json',
+			'Content-Type': 'application/json',
+			authorization: `Bearer ${token}`
+		},
+		body: body ? JSON.stringify(body) : undefined
+	});
+	const json = await res.json().catch(() => ({}));
+	if (!res.ok) {
+		throw json?.detail ?? `NexRAG request failed (${res.status})`;
+	}
+	return json;
+};
+
+export const getOpsOverview = (token: string, days = 7) => request(token, `ops/overview?days=${days}`);
+export const getTraces = (token: string, status = '') =>
+	request(token, `ops/traces?limit=100${status ? `&status=${status}` : ''}`);
+export const getTrace = (token: string, id: string) => request(token, `ops/traces/${id}`);
+export const getProposals = (token: string, status = '') =>
+	request(token, `ops/proposals${status ? `?status=${status}` : ''}`);
+export const getProposal = (token: string, id: string) => request(token, `ops/proposals/${id}`);
+export const reviewProposal = (
+	token: string,
+	id: string,
+	action: 'approve' | 'reject' | 'promote' | 'rollback',
+	note = ''
+) => request(token, `ops/proposals/${id}/${action}`, 'POST', action === 'promote' ? {} : { note });
+export const runEvolution = (token: string) => request(token, 'ops/evolution/run', 'POST', {});
+
+export const getNexragMemories = (token: string, includeHistory = false) =>
+	request(token, `memory${includeHistory ? '?include_history=true' : ''}`);
+export const confirmNexragMemory = (token: string, id: string) =>
+	request(token, `memory/${id}/confirm`, 'POST', {});
+export const forgetNexragMemory = (token: string, id: string) =>
+	request(token, `memory/${id}`, 'DELETE');
+export const forgetAllNexragMemories = (token: string) => request(token, 'memory', 'DELETE');
+// /PATCH NEXRAG OPS DASHBOARD
+
+// Tenants, knowledge base, and exports (see src/api/ops_routes.py, exports_routes.py).
+export const getTenants = (token: string) => request(token, 'ops/tenants');
+export const createTenant = (token: string, tenant_id: string, label: string) =>
+	request(token, 'ops/tenants', 'POST', { tenant_id, label });
+export const deleteTenant = (token: string, tenantId: string) =>
+	request(token, `ops/tenants/${tenantId}`, 'DELETE');
+export const grantTenant = (token: string, email: string, tenant_id: string) =>
+	request(token, 'ops/tenants/grant', 'POST', { email, tenant_id });
+export const revokeTenant = (token: string, email: string, tenant_id: string) =>
+	request(token, 'ops/tenants/revoke', 'POST', { email, tenant_id });
+
+export const getKnowledgeDocuments = (token: string) => request(token, 'ops/knowledge');
+export const deleteKnowledgeDocument = (token: string, fileId: string) =>
+	request(token, `ops/knowledge/${fileId}`, 'DELETE');
+export const uploadKnowledgeDocument = async (token: string, file: File) => {
+	const form = new FormData();
+	form.append('file', file);
+	const res = await fetch(`${WEBUI_BASE_URL}/api/nexrag/ops/knowledge`, {
+		method: 'POST',
+		headers: { authorization: `Bearer ${token}` },
+		body: form
+	});
+	const json = await res.json().catch(() => ({}));
+	if (!res.ok) throw json?.detail ?? `Upload failed (${res.status})`;
+	return json;
+};
+
+export const exportDownloadUrl = (relativePath: string) =>
+	`${WEBUI_BASE_URL}/api/nexrag-download/${relativePath}`;
