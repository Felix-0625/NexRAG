+# PATCH NEXRAG OPS DASHBOARD
+# Proxy the NexRAG operations (admin), personal memory, and export APIs with
+# the verified Open WebUI identity. NexRAG re-checks role=admin for /ops and
+# the signed user ID for /memory and /exports; the browser never sees the
+# service key.
+_NEXRAG_PROXY_PREFIXES = ('ops/', 'memory', 'exports')
+
+
+def _nexrag_headers(request: Request, user) -> dict:
+    service_key = os.environ.get('NEXRAG_SHARED_API_KEY', '')
+    return include_user_info_headers({'Authorization': f'Bearer {service_key}'}, user, request=request)
+
+
+async def _nexrag_proxy(request: Request, user, path: str):
+    if not path.startswith(_NEXRAG_PROXY_PREFIXES) or '..' in path:
+        raise HTTPException(status_code=404, detail='Not found')
+    if path.startswith('ops/') and path != 'ops/feedback' and user.role != 'admin':
+        raise HTTPException(status_code=403, detail='Administrator role required')
+    base_url = os.environ.get('NEXRAG_API_BASE_URL', '').rstrip('/')
+    service_key = os.environ.get('NEXRAG_SHARED_API_KEY', '')
+    if not base_url or len(service_key) < 32:
+        raise HTTPException(status_code=503, detail='NexRAG service is not configured')
+    headers = _nexrag_headers(request, user)
+    body = await request.body() if request.method in ('POST', 'PUT', 'DELETE') else None
+    if body:
+        headers['Content-Type'] = 'application/json'
+    try:
+        async with aiohttp.ClientSession(timeout=aiohttp.ClientTimeout(total=300)) as session:
+            async with session.request(
+                request.method, f'{base_url}/{path}', params=dict(request.query_params), data=body, headers=headers
+            ) as response:
+                payload = await response.json(content_type=None)
+                if response.status >= 400:
+                    detail = payload.get('detail') if isinstance(payload, dict) else None
+                    raise HTTPException(status_code=response.status, detail=detail or 'NexRAG request failed')
+                return payload
+    except aiohttp.ClientError as exc:
+        raise HTTPException(status_code=502, detail='NexRAG service is unavailable') from exc
+
+
+@app.api_route('/api/nexrag/{path:path}', methods=['GET', 'POST', 'DELETE'])
+async def nexrag_proxy(request: Request, path: str, user=Depends(get_verified_user)):
+    return await _nexrag_proxy(request, user, path)
+
+
+@app.get('/api/nexrag-download/{relative_path:path}')
+async def nexrag_export_download(request: Request, relative_path: str, user=Depends(get_verified_user)):
+    """Stream one export file's bytes; the JSON proxy above can't carry binary content."""
+    if '..' in relative_path:
+        raise HTTPException(status_code=404, detail='Not found')
+    base_url = os.environ.get('NEXRAG_API_BASE_URL', '').rstrip('/')
+    service_key = os.environ.get('NEXRAG_SHARED_API_KEY', '')
+    if not base_url or len(service_key) < 32:
+        raise HTTPException(status_code=503, detail='NexRAG service is not configured')
+    headers = _nexrag_headers(request, user)
+    try:
+        async with aiohttp.ClientSession(timeout=aiohttp.ClientTimeout(total=60)) as session:
+            async with session.get(f'{base_url}/exports/download/{relative_path}', headers=headers) as response:
+                if response.status >= 400:
+                    raise HTTPException(status_code=response.status, detail='Export not found')
+                data = await response.read()
+                return Response(
+                    content=data,
+                    media_type=response.headers.get('content-type', 'application/octet-stream'),
+                    headers={'Content-Disposition': response.headers.get('content-disposition', '')},
+                )
+    except aiohttp.ClientError as exc:
+        raise HTTPException(status_code=502, detail='NexRAG service is unavailable') from exc
+# /PATCH NEXRAG OPS DASHBOARD
+
+
